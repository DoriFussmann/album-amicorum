# Public build-time settings. Copy to .env for local overrides; set the same
# names in Vercel → Settings → Environment Variables for production.
# Leave a value empty to keep that feature off.

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
PUBLIC_ANALYTICS_ID=

# Google Ads tag ID, e.g. AW-123456789, and conversion labels (Google Ads →
# Goals → Conversions → the action → Tag setup). Empty label = not sent.
PUBLIC_GOOGLE_ADS_ID=
PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=
PUBLIC_GOOGLE_ADS_ADD_TO_CART_LABEL=
PUBLIC_GOOGLE_ADS_BEGIN_CHECKOUT_LABEL=

# Google Search Console HTML-tag verification token
PUBLIC_SEARCH_CONSOLE_VERIFICATION=

# Server-side (Vercel only, not PUBLIC_): token from TNV → Analytics → Setup.
# Turns on AI-crawler reporting in site/middleware.js. Leave unset to keep it off.
TNV_BOT_TOKEN=
