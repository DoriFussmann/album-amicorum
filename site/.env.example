# Album Amicorum — env template (no secrets)
# Copy to .env.local and fill in values.

# --- Stripe (Test mode first) ---
STRIPE_SECRET_KEY=sk_test_PASTE_HERE
PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_PASTE_HERE
STRIPE_WEBHOOK_SECRET=whsec_PASTE_HERE

# --- Stripe Price IDs ---
STRIPE_PRICE_FOREST=price_PASTE_HERE
STRIPE_PRICE_DINOSAURS=price_PASTE_HERE
STRIPE_PRICE_MERMAIDS=price_PASTE_HERE
STRIPE_PRICE_ANIMALS=price_PASTE_HERE
STRIPE_PRICE_FLOWERS=price_PASTE_HERE
STRIPE_PRICE_SPACE=price_PASTE_HERE
STRIPE_PRICE_FAIRIES=price_PASTE_HERE

# --- Site URL (Stripe success/cancel redirects) ---
PUBLIC_SITE_URL=http://localhost:4321

# --- Resend (ops email when an order is paid) ---
RESEND_API_KEY=re_PASTE_HERE
ORDER_NOTIFY_EMAIL=hello@albumamicorum.com
ORDER_FROM_EMAIL=hello@albumamicorum.com
