---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_NAME, SITE_URL, SITE_LOGO_PATH, SAME_AS } from '../config/site';
import { absoluteUrl } from '../lib/url';
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/600.css';
import '@fontsource/cormorant-garamond/700.css';
import '@fontsource/nunito/300.css';
import '@fontsource/nunito/400.css';
import '@fontsource/nunito/600.css';
import '@fontsource/nunito/700.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  /** Absolute canonical URL override (when frontmatter sets a full URL). */
  canonicalUrl?: string;
  robots?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  twitterCard?: string;
  locale?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  canonicalPath = '/',
  canonicalUrl,
  robots = 'index, follow',
  ogTitle,
  ogDescription,
  ogImage,
  twitterCard = 'summary_large_image',
  locale = 'en-US',
  jsonLd = [],
} = Astro.props;

if (!title || !description) {
  throw new Error('BaseLayout requires unique title and description props on every page.');
}

const canonical = canonicalUrl || absoluteUrl(canonicalPath);
const resolvedOgTitle = ogTitle || title;
const resolvedOgDescription = ogDescription || description;
const defaultOgImage = absoluteUrl('/images/og-default.png');
const resolvedOgImage = ogImage || defaultOgImage;
const logoAbsolute = absoluteUrl(SITE_LOGO_PATH);

const organizationLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE_NAME,
  url: SITE_URL,
  logo: logoAbsolute,
  sameAs: SAME_AS,
};

const jsonLdBlocks = Array.isArray(jsonLd) ? jsonLd : [jsonLd];
const allLd = [organizationLd, ...jsonLdBlocks.filter(Boolean)];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} RSS`} href={absoluteUrl('/rss.xml')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={locale} />
    <meta property="og:title" content={resolvedOgTitle} />
    <meta property="og:description" content={resolvedOgDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={resolvedOgImage} />

    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={resolvedOgTitle} />
    <meta name="twitter:description" content={resolvedOgDescription} />
    <meta name="twitter:image" content={resolvedOgImage} />

    {allLd.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <script>
      function initReveal() {
        const nodes = document.querySelectorAll('[data-reveal]');
        if (!nodes.length) return;

        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          nodes.forEach((node) => node.classList.add('is-visible'));
          return;
        }

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            });
          },
          { threshold: 0.16, rootMargin: '0px 0px -8% 0px' },
        );

        nodes.forEach((node) => observer.observe(node));
      }

      initReveal();
      document.addEventListener('astro:page-load', initReveal);
    </script>
  </body>
</html>
