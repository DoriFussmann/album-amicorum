---
import { Picture } from 'astro:assets';
import whyParentsImage from '../assets/images/why-parents.jpg';
import passItOnImage from '../assets/images/pass-it-on.jpg';
import watchItGrowImage from '../assets/images/watch-it-grow.jpg';

const moments = [
  {
    title: 'A page gets filled',
    body: 'It starts with a name, a few favorites, and whatever makes you you right now. Then the bookmark slides forward, leaving the next page open for someone else.',
    image: whyParentsImage,
    imageAlt: 'A child writing by hand in an open My Friends Book',
    tilt: '-2.2deg',
  },
  {
    title: 'Passed to a friend',
    body: 'The book goes wherever the people are — a friend, a cousin, a teacher, a coach — anyone who has made life a little brighter.',
    image: passItOnImage,
    imageAlt: 'A child walking through a meadow, carrying a My Friends Book',
    tilt: '1.8deg',
  },
  {
    title: 'Kept for years',
    body: 'Each person leaves a page, a drawing, a bit of themselves. Long after, it is still a book full of people who loved you.',
    image: watchItGrowImage,
    imageAlt: 'A family gathered around a picnic table in a garden, looking together at an open My Friends Book',
    tilt: '-1.5deg',
  },
] as const;
---

<section id="how-it-works" class="journey section-space" aria-labelledby="how-it-works-heading">
  <div class="site-container">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold tracking-wide text-ink-muted">The journey</p>
      <h2 id="how-it-works-heading" class="mt-3">A page, a friend, a lifetime</h2>
    </div>

    <div class="journey-track">
      <svg
        class="journey-curve"
        viewBox="0 0 100 100"
        preserveAspectRatio="none"
        aria-hidden="true"
        focusable="false"
      >
        <path
          d="M16 2
             C 24 9, 8 15, 18 23
             C 34 35, 62 27, 76 39
             C 90 51, 68 59, 48 65
             C 26 72, 10 69, 15 81
             C 21 92, 42 87, 30 98"
          fill="none"
          stroke="currentColor"
          stroke-width="2.25"
          stroke-linecap="round"
          stroke-linejoin="round"
          vector-effect="non-scaling-stroke"
        />
      </svg>

      {
        moments.map((moment) => (
          <article class="journey-moment" style={`--tilt: ${moment.tilt}`}>
            <div class="journey-photo">
              <Picture
                src={moment.image}
                alt={moment.imageAlt}
                widths={[480, 800]}
                sizes="(min-width: 768px) 220px, 70vw"
                formats={['avif', 'webp']}
                fallbackFormat="webp"
                pictureAttributes={{ class: 'journey-photo__frame' }}
                class="journey-photo__img"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="journey-copy">
              <h3>{moment.title}</h3>
              <p>{moment.body}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .journey-track {
    position: relative;
    margin-top: 3.25rem;
    display: flex;
    flex-direction: column;
    gap: 3.25rem;
  }

  .journey-curve {
    position: absolute;
    inset: -0.5rem 4% -0.5rem;
    z-index: 0;
    width: auto;
    height: auto;
    color: #8fa8a0;
    opacity: 0.72;
    pointer-events: none;
  }

  .journey-moment {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.1rem;
  }

  .journey-moment:nth-of-type(odd) {
    margin-right: 1.35rem;
  }

  .journey-moment:nth-of-type(even) {
    align-items: flex-end;
    margin-left: 1.35rem;
    text-align: right;
  }

  .journey-photo {
    width: 70vw;
    max-width: 16.5rem;
    transform: rotate(var(--tilt));
    filter: drop-shadow(0 12px 16px rgba(59, 53, 48, 0.14));
  }

  .journey-photo :global(.journey-photo__frame) {
    display: block;
  }

  .journey-photo :global(.journey-photo__img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .journey-copy {
    max-width: 36rem;
  }

  .journey-copy h3 {
    margin: 0;
    font-size: clamp(1.55rem, 2.4vw, 2rem);
    line-height: 1.15;
  }

  .journey-copy p {
    margin: 0.65rem 0 0;
    max-width: 38ch;
    line-height: 1.7;
  }

  .journey-moment:nth-of-type(even) .journey-copy p {
    margin-left: auto;
  }

  @media (min-width: 768px) {
    .journey-track {
      gap: 4.5rem;
      margin-top: 4.25rem;
    }

    .journey-moment,
    .journey-moment:nth-of-type(odd),
    .journey-moment:nth-of-type(even) {
      flex-direction: row;
      align-items: center;
      justify-content: flex-start;
      gap: 2.75rem;
      width: min(100%, 44rem);
      margin-right: 0;
      margin-left: 0;
      text-align: left;
    }

    .journey-moment:nth-of-type(even) {
      flex-direction: row-reverse;
      margin-left: auto;
    }

    .journey-moment:nth-of-type(even) .journey-copy p {
      margin-left: 0;
    }

    .journey-photo {
      width: 220px;
      max-width: none;
      flex: 0 0 220px;
    }
  }
</style>
