---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;
const items = headings.filter((heading) => heading.depth === 2);
---

{
  items.length > 0 && (
    <nav aria-labelledby="toc-heading" class="mb-12 w-full border-b border-border pb-10">
      <h2 id="toc-heading" class="mb-4 font-body text-sm font-semibold tracking-wide text-ink-muted">
        On this page
      </h2>
      <ol class="columns-1 gap-x-12 space-y-2 md:columns-2">
        {items.map((heading, index) => (
          <li class="break-inside-avoid">
            <a
              href={`#${heading.slug}`}
              class="group inline-flex min-h-11 items-baseline gap-3 text-base text-ink no-underline hover:text-primary"
            >
              <span class="w-6 shrink-0 font-body text-sm font-light text-ink-muted tabular-nums">
                {String(index + 1).padStart(2, '0')}
              </span>
              <span class="group-hover:underline">{heading.text}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
  )
}
