---
import Reveal from './Reveal.astro';
---

<section
  id="begin"
  aria-labelledby="closing-cta-heading"
  class="section-space pb-8 md:pb-12"
>
  <div class="site-container">
    <Reveal>
      <div class="mx-auto max-w-2xl text-center">
        <h2 id="closing-cta-heading">Begin your child's Friend Book.</h2>
        <p class="mt-6 leading-[1.7]">Some memories grow more meaningful with time.</p>
        <p class="mt-2 leading-[1.7]">Start collecting them today.</p>
        <div class="mt-10">
          <a class="btn btn-primary" href="#collection">Explore the Collection</a>
        </div>
      </div>
    </Reveal>
  </div>
</section>
