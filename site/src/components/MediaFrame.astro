---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  image: string;
  alt: string;
  /**
   * Either a file under src/assets/ (written "src/assets/images/hero.jpg"; resized
   * and converted to WebP at build) or a public URL ("/images/x.jpg").
   */
  src?: string;
  eager?: boolean;
  sizes?: string;
}
const { image, alt, src, eager = false, sizes = "(min-width: 1024px) 50vw, 100vw" } = Astro.props;

const assets = import.meta.glob<{ default: ImageMetadata }>("../assets/**/*.{jpg,jpeg,png,webp}", {
  eager: true,
});
const assetKey = src?.replace(/^\/?src\//, "../");
const asset = assetKey ? assets[assetKey]?.default : undefined;
if (src && /^\/?src\/assets\//.test(src) && !asset) {
  throw new Error(`MediaFrame: no asset at ${src}`);
}
const hasSrc = typeof src === "string" && src.length > 0;
---

<div class="media-frame">
  {asset ? (
    <Image
      src={asset}
      alt={alt}
      widths={[480, 768, 1080, 1440]}
      sizes={sizes}
      loading={eager ? "eager" : "lazy"}
      fetchpriority={eager ? "high" : undefined}
    />
  ) : hasSrc ? (
    <img src={src} alt={alt} loading={eager ? "eager" : "lazy"} />
  ) : (
    <div class="placeholder-frame">
      <p>{image}</p>
      <p class="placeholder-label">Image placeholder</p>
    </div>
  )}
</div>
