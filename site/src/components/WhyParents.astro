---
import SiteImage from './SiteImage.astro';
import whyParentsImage from '../assets/images/why-parents.jpg';
// No approved image brief in Website Specification v1.0 for this section.
// See imageBriefs.whyParents in src/data/imageBriefs.ts

const reasons = [
  {
    title: 'Screen-free connection',
    body: 'A quiet alternative to digital keepsakes — something children can hold, turn, and return to.',
  },
  {
    title: 'Made for little hands',
    body: 'Thoughtful paper, gentle prompts, and space to draw so every age can leave a mark.',
  },
  {
    title: 'Gifts that grow meaning',
    body: 'Perfect for birthdays, school years, and farewells — a keepsake for years to come.',
  },
  {
    title: 'Beautiful on the shelf',
    body: 'Soft covers and natural tones that feel at home in a Waldorf-inspired room.',
  },
];
---

<section id="why-parents" aria-labelledby="why-parents-heading" class="section-space bg-surface/40">
  <div class="site-container grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
    <div>
      <h2 id="why-parents-heading">Why Parents Love It</h2>
      <ul class="mt-10">
        {
          reasons.map((reason) => (
            <li class="pencil-rule py-6 first:pt-2">
              <h3 class="text-lg md:text-xl">{reason.title}</h3>
              <p class="mt-2 leading-[1.7]">{reason.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
    <SiteImage
      src={whyParentsImage}
      alt="A child writing by hand in an open My Friends Book"
      aspectClass="aspect-[4/5]"
    />
  </div>
</section>
