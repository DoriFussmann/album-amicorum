---
import type { CollectionEntry } from 'astro:content';
import Reveal from './Reveal.astro';
import BookCard from './BookCard.astro';

interface Props {
  books: CollectionEntry<'books'>[];
}

const { books } = Astro.props;
const offsets = ['none', 'up', 'down', 'up', 'none', 'down', 'up'] as const;
---

<section id="collection" aria-labelledby="collection-heading" class="section-space">
  <div class="site-container">
    <div class="mx-auto mb-14 max-w-2xl text-center">
      <p class="text-sm font-semibold tracking-wide text-ink-muted">Choose a world.</p>
      <h2 id="collection-heading" class="mt-3">My Friends Book</h2>
      <p class="mt-4 text-ink">Every edition tells the same story.</p>
      <p class="mt-2 text-ink">
        Choose the world your child will be excited to share with friends.
      </p>
    </div>

    {
      books.length === 0 ? (
        <div class="mx-auto max-w-md text-center">
          <p class="text-ink">No editions available right now.</p>
          <p class="mt-2 text-ink-muted">Please check back soon.</p>
        </div>
      ) : (
        <ul class="grid gap-12 overflow-visible sm:grid-cols-2 lg:grid-cols-3 lg:gap-x-8 lg:gap-y-14">
          {books.map((book, i) => (
            <li>
              <Reveal delay={Math.min(i, 3) * 33}>
                <BookCard
                  title={book.data.title}
                  slug={book.data.slug}
                  tagline={book.data.tagline}
                  price={book.data.price}
                  cover={book.data.cover}
                  interior={book.data.interior}
                  gallery={book.data.gallery}
                  offset={offsets[i % offsets.length]}
                />
              </Reveal>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>
