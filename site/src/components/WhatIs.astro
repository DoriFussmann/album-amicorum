---
import Reveal from './Reveal.astro';
import ImagePlaceholder from './ImagePlaceholder.astro';
// Image brief / prompt: imageBriefs.whatIs in src/data/imageBriefs.ts

const features = [
  {
    title: 'Every friend leaves a page',
    body: 'Each friend adds their own memories, drawings, and handwriting, making every page as unique as the person who created it.',
  },
  {
    title: 'Written by hand',
    body: 'Some memories deserve more than a screen. Handwriting captures personality in a way nothing else can.',
  },
  {
    title: 'Made to be treasured',
    body: 'Long after childhood has passed, My Friends Book becomes a keepsake filled with the voices, creativity, and friendships that shaped those years.',
  },
];
---

<section id="what-is" aria-labelledby="what-is-heading" class="section-space">
  <div class="site-container grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
    <div>
      <Reveal>
        <p class="text-sm font-semibold tracking-wide text-ink-muted">What is My Friends Book?</p>
        <h2 id="what-is-heading" class="mt-3">
          A book that becomes the story of childhood friendships.
        </h2>
      </Reveal>
      <Reveal delay={80}>
        <p class="mt-6 max-w-content leading-[1.7]">
          My Friends Book is a beautifully illustrated Friend Book where friends leave behind
          handwritten memories, drawings, favorite things, and little pieces of themselves.
        </p>
      </Reveal>
      <Reveal delay={140}>
        <p class="mt-4 max-w-content leading-[1.7]">
          As each page is filled, the book becomes something no one else will ever own—a one-of-a-kind
          keepsake created by the people who matter most.
        </p>
      </Reveal>
      <ul class="mt-10 space-y-6">
        {
          features.map((feature, i) => (
            <Reveal delay={180 + i * 70}>
              <li class="border-t border-border pt-5">
                <h3 class="text-lg md:text-xl">{feature.title}</h3>
                <p class="mt-2 leading-[1.7] text-ink">{feature.body}</p>
              </li>
            </Reveal>
          ))
        }
      </ul>
    </div>
    <Reveal delay={120} class="lg:justify-self-end">
      <ImagePlaceholder
        briefId="what-is"
        label="Photograph forthcoming"
        caption="Friends sharing My Friends Book"
        aspectClass="aspect-[4/5] max-w-md lg:max-w-none"
      />
    </Reveal>
  </div>
</section>
