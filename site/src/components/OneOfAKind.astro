---
import Reveal from './Reveal.astro';
import ImagePlaceholder from './ImagePlaceholder.astro';
// Image brief / prompt: imageBriefs.oneOfAKind in src/data/imageBriefs.ts
---

<section id="one-of-a-kind" aria-labelledby="one-of-a-kind-heading" class="section-space">
  <div class="site-container">
    <Reveal>
      <ImagePlaceholder
        briefId="one-of-a-kind"
        label="Photograph forthcoming"
        caption="Every page uniquely filled"
        aspectClass="aspect-video w-full"
        class="mb-12 md:mb-16"
      />
    </Reveal>

    <div class="mx-auto max-w-2xl text-center">
      <Reveal delay={80}>
        <h2 id="one-of-a-kind-heading">Every Friend Book becomes one of a kind.</h2>
      </Reveal>
      <Reveal delay={140}>
        <p class="mt-8 leading-[1.7]">No two books will ever be the same.</p>
        <p class="mt-4 leading-[1.7]">Every friend leaves something different behind.</p>
        <p class="mt-4 leading-[1.7]">Different handwriting.</p>
        <p class="mt-2 leading-[1.7]">Different drawings.</p>
        <p class="mt-2 leading-[1.7]">Different memories.</p>
        <p class="mt-2 leading-[1.7]">Different personalities.</p>
        <p class="mt-6 leading-[1.7]">
          By the final page, the book has become something impossible to recreate—a collection of
          childhood friendships unlike any other.
        </p>
      </Reveal>
    </div>
  </div>
</section>
