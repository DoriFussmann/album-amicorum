---
import BookGallery from './BookGallery.astro';
import { bookCoverAlt, bookGalleryAlt, bookInteriorAlt } from '../lib/bookImageAlt';

interface Props {
  title: string;
  slug: string;
  tagline: string;
  price: string;
  cover: string;
  interior: string;
  gallery?: string[];
  offset?: 'up' | 'down' | 'none';
}

const { title, slug, tagline, price, cover, interior, gallery, offset = 'none' } = Astro.props;

const offsetClass =
  offset === 'up' ? 'md:-translate-y-6' : offset === 'down' ? 'md:mt-8' : '';

const previewId = `preview-${slug}`;
const coverAlt = bookCoverAlt(title);
const interiorAlt = bookInteriorAlt(title);
const images = (gallery?.length ? gallery : [cover, interior]).map((src) => ({
  src,
  alt: bookGalleryAlt(title, src),
}));
const cartPayload = JSON.stringify({ slug, title, price, cover });
---

<article class:list={['book-card group', offsetClass]}>
  <a href={`/friend-book/${slug}/`} class="block text-inherit no-underline">
    <div class="media-warm aspect-square overflow-hidden bg-surface shadow-soft transition-shadow duration-gentle group-hover:shadow-lift">
      <div class="relative h-full w-full">
        <img
          src={cover}
          alt={coverAlt}
          width="400"
          height="400"
          class="absolute inset-0 h-full w-full object-contain object-center transition-opacity duration-500 ease-out group-hover:opacity-0"
          loading="lazy"
          decoding="async"
        />
        <img
          src={interior}
          alt={interiorAlt}
          width="400"
          height="400"
          class="absolute inset-0 h-full w-full object-contain object-center opacity-0 transition-opacity duration-500 ease-out group-hover:opacity-100"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
    <div class="mt-5">
      <h3 class="text-xl font-semibold md:text-xl">{title}</h3>
      <p class="mt-1 font-display text-lg italic text-ink-muted">{tagline}</p>
      <p class="mt-2 text-sm font-semibold tracking-wide text-ink-heading">{price}</p>
    </div>
  </a>
  <div class="mt-4">
    <button type="button" class="btn btn-secondary" data-preview-open={previewId}>
      Preview
    </button>
  </div>

  <dialog
    id={previewId}
    class="book-preview-dialog h-[min(90vh,52rem)] w-[min(calc(100%-1.5rem),44.88rem)] flex-col overflow-hidden rounded-soft border border-border bg-canvas p-0 shadow-lift backdrop:bg-ink/40"
    aria-labelledby={`${previewId}-title`}
    data-preview-gallery
    data-cart-scope
  >
    <BookGallery images={images} class="relative min-h-0 flex-[3]" />

    <div class="shrink-0 px-6 py-4 md:px-8">
      <h2 id={`${previewId}-title`} class="text-2xl">My Friends Book — {title}</h2>

      <p class="mt-2 leading-[1.45]">
        My Friends Book invites friends to leave handwritten memories, drawings, favorite things, and
        messages that together become a keepsake unlike any other.
      </p>
      <p class="mt-2 leading-[1.45]">
        Every completed book tells a different story because every friendship is different.
      </p>
      <p class="mt-3 text-sm font-semibold tracking-wide text-ink-heading">{price}</p>
      <p class="mt-1 text-sm text-ink-muted">Shipping calculated separately at checkout.</p>

      <div class="mt-4 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        <button
          type="button"
          class="btn btn-primary"
          data-add-to-cart
          data-cart-item={cartPayload}
        >
          Add to Cart
        </button>
        <button type="button" class="btn btn-secondary" data-preview-close>
          Continue Browsing
        </button>
      </div>
      <p class="mt-2 min-h-5 text-sm text-ink-muted" data-cart-feedback aria-live="polite"></p>
    </div>
  </dialog>
</article>

<script>
  import { bindAddToCartButtons } from '../lib/bindAddToCart';

  function initBookPreviews() {
    document.querySelectorAll<HTMLButtonElement>('[data-preview-open]').forEach((button) => {
      if (button.dataset.previewBound === 'true') return;
      const id = button.getAttribute('data-preview-open');
      if (!id) return;
      const dialog = document.getElementById(id);
      if (!(dialog instanceof HTMLDialogElement)) return;

      button.addEventListener('click', () => {
        dialog.showModal();
      });
      button.dataset.previewBound = 'true';
    });

    document.querySelectorAll<HTMLButtonElement>('[data-preview-close]').forEach((button) => {
      if (button.dataset.previewBound === 'true') return;
      button.addEventListener('click', () => {
        const dialog = button.closest('dialog');
        if (dialog instanceof HTMLDialogElement) dialog.close();
      });
      button.dataset.previewBound = 'true';
    });

    document.querySelectorAll('dialog.book-preview-dialog').forEach((dialog) => {
      if (!(dialog instanceof HTMLDialogElement)) return;
      if (dialog.dataset.backdropBound === 'true') return;
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });
      dialog.dataset.backdropBound = 'true';
    });

    bindAddToCartButtons();
  }

  initBookPreviews();
  document.addEventListener('astro:page-load', initBookPreviews);
</script>
