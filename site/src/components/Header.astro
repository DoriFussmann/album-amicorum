---
import { getCollection } from 'astro:content';
import Logo from './Logo.astro';
import { isListedTheme, sortThemes } from '../lib/themes';

const beforeThemes = [
  { href: '/#what-is', label: 'My Friends Book' },
  { href: '/#how-it-works', label: 'How It Works' },
];
const afterThemes = [
  { href: '/#story', label: 'Our Story' },
  { href: '/#testimonials', label: 'Testimonials' },
  { href: '/articles/', label: 'Articles' },
];

const themes = sortThemes((await getCollection('books')).filter(isListedTheme));
---

<header class="sticky top-0 z-40">
  <!-- Keep blur off <header> so position:fixed nav overlays use the viewport. -->
  <div
    class="pointer-events-none absolute inset-0 border-b border-border/40 bg-canvas/80 backdrop-blur-md"
    aria-hidden="true"
  ></div>
  <div class="site-container relative">
    <nav class="flex min-h-28 items-center justify-between gap-6 py-2" aria-label="Primary">
      <Logo size="sm" withWordmark={true} />

      <ul class="hidden items-center gap-1 md:flex">
        {
          beforeThemes.map((link) => (
            <li>
              <a class="nav-link" href={link.href}>
                {link.label}
              </a>
            </li>
          ))
        }
        <li class="relative" data-themes-menu>
          <button
            type="button"
            class="nav-link"
            aria-haspopup="menu"
            aria-expanded="false"
            aria-controls="themes-menu"
            data-themes-trigger
          >
            Themes
            <svg class="ml-1 h-3.5 w-3.5" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path
                d="M5 7.5L10 12.5L15 7.5"
                stroke="currentColor"
                stroke-width="1.25"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </button>
          <ul
            id="themes-menu"
            role="menu"
            hidden
            class="absolute left-0 top-full z-50 mt-1 min-w-[12rem] rounded-soft border border-border bg-surface py-2 shadow-soft"
            data-themes-panel
          >
            {
              themes.map((theme) => (
                <li role="none">
                  <a
                    role="menuitem"
                    href={`/friend-book/${theme.data.slug}/`}
                    class="flex min-h-11 items-center px-4 text-sm text-ink no-underline hover:bg-canvas hover:text-primary"
                  >
                    {theme.data.title}
                  </a>
                </li>
              ))
            }
            <li role="none">
              <a
                role="menuitem"
                href="/friend-book/"
                class="flex min-h-11 items-center px-4 text-sm text-ink no-underline hover:bg-canvas hover:text-primary"
              >
                All themes
              </a>
            </li>
          </ul>
        </li>
        {
          afterThemes.map((link) => (
            <li>
              <a class="nav-link" href={link.href}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="flex items-center gap-2">
        <a
          href="/cart/"
          class="relative inline-flex min-h-11 min-w-11 items-center justify-center rounded-soft text-ink-heading no-underline focus-ring"
          aria-label="Cart"
          data-cart-link
        >
          <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="M6.5 7h11l-1 11h-9l-1-11Z"
              stroke="currentColor"
              stroke-width="1.25"
              stroke-linejoin="round"
            />
            <path
              d="M9 7a3 3 0 0 1 6 0"
              stroke="currentColor"
              stroke-width="1.25"
              stroke-linecap="round"
            />
          </svg>
          <span
            class="absolute -right-0.5 -top-0.5 hidden min-w-5 items-center justify-center rounded-full bg-primary px-1.5 py-0.5 text-[11px] font-semibold leading-none text-canvas"
            data-cart-count
            aria-hidden="true"
          ></span>
        </a>

        <details class="group md:hidden" data-mobile-nav>
          <summary
            class="relative z-50 flex min-h-11 min-w-11 cursor-pointer list-none items-center justify-center rounded-soft text-ink-heading focus-ring [&::-webkit-details-marker]:hidden"
            aria-label="Open menu"
            aria-expanded="false"
          >
            <span class="sr-only">Menu</span>
            <svg class="h-6 w-6 group-open:hidden" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" />
            </svg>
            <svg class="hidden h-6 w-6 group-open:block" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" />
            </svg>
          </summary>
          <div
            class="fixed inset-x-0 top-28 bottom-0 z-30 bg-ink-heading/40"
            data-mobile-nav-backdrop
            aria-hidden="true"
          ></div>
          <ul
            class="fixed inset-x-0 top-28 z-40 max-h-[calc(100dvh-7rem)] overflow-y-auto border-b border-border bg-surface px-4 py-3 shadow-soft"
          >
            {
              beforeThemes.map((link) => (
                <li>
                  <a class="nav-link flex min-h-11 w-full items-center" href={link.href}>
                    {link.label}
                  </a>
                </li>
              ))
            }
            <li>
              <button
                type="button"
                class="nav-link flex min-h-11 w-full items-center"
                aria-expanded="false"
                aria-controls="mobile-themes-panel"
                data-themes-accordion
              >
                Themes
              </button>
              <ul id="mobile-themes-panel" class="pb-1 pl-3" hidden data-themes-accordion-panel>
                {
                  themes.map((theme) => (
                    <li>
                      <a
                        class="nav-link flex min-h-11 w-full items-center"
                        href={`/friend-book/${theme.data.slug}/`}
                      >
                        {theme.data.title}
                      </a>
                    </li>
                  ))
                }
                <li>
                  <a class="nav-link flex min-h-11 w-full items-center" href="/friend-book/">
                    All themes
                  </a>
                </li>
              </ul>
            </li>
            {
              afterThemes.map((link) => (
                <li>
                  <a class="nav-link flex min-h-11 w-full items-center" href={link.href}>
                    {link.label}
                  </a>
                </li>
              ))
            }
            <li>
              <a class="nav-link flex min-h-11 w-full items-center" href="/cart/">Cart</a>
            </li>
          </ul>
        </details>
      </div>
    </nav>
  </div>
</header>

<script>
  import { CART_UPDATED_EVENT, cartCount, getCart } from '../lib/cart';

  function updateCartBadge() {
    const count = cartCount(getCart());
    document.querySelectorAll<HTMLElement>('[data-cart-count]').forEach((badge) => {
      if (count > 0) {
        badge.textContent = String(count);
        badge.classList.remove('hidden');
        badge.classList.add('inline-flex');
      } else {
        badge.textContent = '';
        badge.classList.add('hidden');
        badge.classList.remove('inline-flex');
      }
    });

    document.querySelectorAll<HTMLAnchorElement>('[data-cart-link]').forEach((link) => {
      link.setAttribute('aria-label', count > 0 ? `Cart, ${count} items` : 'Cart');
    });
  }

  function initCartBadge() {
    updateCartBadge();
    if (document.documentElement.dataset.cartBadgeBound === 'true') return;
    window.addEventListener(CART_UPDATED_EVENT, updateCartBadge);
    window.addEventListener('storage', (event) => {
      if (event.key === 'album-amicorum-cart') updateCartBadge();
    });
    document.documentElement.dataset.cartBadgeBound = 'true';
  }

  function initMobileNav() {
    document.querySelectorAll<HTMLDetailsElement>('[data-mobile-nav]').forEach((details) => {
      if (details.dataset.navBound === 'true') return;
      details.dataset.navBound = 'true';

      const summary = details.querySelector('summary');
      const backdrop = details.querySelector('[data-mobile-nav-backdrop]');

      const syncOpenState = () => {
        const open = details.open;
        document.body.classList.toggle('overflow-hidden', open);
        summary?.setAttribute('aria-expanded', open ? 'true' : 'false');
        summary?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      };

      details.addEventListener('toggle', syncOpenState);
      backdrop?.addEventListener('click', () => {
        details.open = false;
      });
      details.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          details.open = false;
        });
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && details.open) details.open = false;
      });
      syncOpenState();
    });
  }

  function initThemesMenu() {
    document.querySelectorAll<HTMLElement>('[data-themes-menu]').forEach((root) => {
      if (root.dataset.themesBound === 'true') return;
      const trigger = root.querySelector<HTMLButtonElement>('[data-themes-trigger]');
      const panel = root.querySelector<HTMLElement>('[data-themes-panel]');
      if (!trigger || !panel) return;
      const items = [...panel.querySelectorAll<HTMLElement>('[role="menuitem"]')];

      const setOpen = (open: boolean, restoreFocus = false) => {
        panel.hidden = !open;
        trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
        if (!open && restoreFocus) trigger.focus();
      };

      trigger.addEventListener('click', () => {
        const open = trigger.getAttribute('aria-expanded') !== 'true';
        setOpen(open);
        if (open) items[0]?.focus();
      });

      trigger.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowDown' || event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          setOpen(true);
          items[0]?.focus();
        }
        if (event.key === 'Escape') setOpen(false, true);
      });

      panel.addEventListener('keydown', (event) => {
        const current = items.indexOf(document.activeElement as HTMLElement);
        if (event.key === 'Escape') {
          event.preventDefault();
          setOpen(false, true);
        }
        if (event.key === 'ArrowDown') {
          event.preventDefault();
          items[(current + 1 + items.length) % items.length]?.focus();
        }
        if (event.key === 'ArrowUp') {
          event.preventDefault();
          items[(current - 1 + items.length) % items.length]?.focus();
        }
        if (event.key === 'Home') {
          event.preventDefault();
          items[0]?.focus();
        }
        if (event.key === 'End') {
          event.preventDefault();
          items[items.length - 1]?.focus();
        }
      });

      document.addEventListener('click', (event) => {
        if (!root.contains(event.target as Node)) setOpen(false);
      });

      items.forEach((item) => {
        item.addEventListener('click', () => setOpen(false));
      });

      root.dataset.themesBound = 'true';
    });
  }

  function initThemesAccordion() {
    document.querySelectorAll<HTMLButtonElement>('[data-themes-accordion]').forEach((button) => {
      if (button.dataset.themesBound === 'true') return;
      const panelId = button.getAttribute('aria-controls');
      const panel = panelId ? document.getElementById(panelId) : null;
      button.addEventListener('click', () => {
        const open = button.getAttribute('aria-expanded') === 'true';
        button.setAttribute('aria-expanded', open ? 'false' : 'true');
        if (panel) panel.hidden = open;
      });
      button.dataset.themesBound = 'true';
    });
  }

  initCartBadge();
  initMobileNav();
  initThemesMenu();
  initThemesAccordion();
  document.addEventListener('astro:page-load', initCartBadge);
  document.addEventListener('astro:page-load', initMobileNav);
  document.addEventListener('astro:page-load', initThemesMenu);
  document.addEventListener('astro:page-load', initThemesAccordion);
</script>
