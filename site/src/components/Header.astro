---
import { SITE_NAME } from '../config/site';
---

<header class="sticky top-0 z-40 border-b border-border/60 bg-canvas/90 backdrop-blur-sm">
  <div class="site-container">
    <nav class="flex min-h-16 items-center justify-between gap-6 py-2" aria-label="Primary">
      <a
        href="/"
        class="font-display text-2xl font-semibold tracking-wide text-ink-heading no-underline transition-colors duration-gentle hover:text-primary hover:no-underline focus-ring rounded-sm"
      >
        {SITE_NAME}
      </a>

      <ul class="hidden items-center gap-1 md:flex">
        <li><a class="nav-link" href="/">Home</a></li>
        <li><a class="nav-link" href="/articles/">Articles</a></li>
        <li><a class="nav-link" href="/team/">Team</a></li>
      </ul>

      <details class="group relative md:hidden">
        <summary
          class="flex min-h-11 min-w-11 cursor-pointer list-none items-center justify-center rounded-soft text-ink-heading focus-ring [&::-webkit-details-marker]:hidden"
          aria-label="Open menu"
        >
          <span class="sr-only">Menu</span>
          <svg class="h-6 w-6 group-open:hidden" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" />
          </svg>
          <svg class="hidden h-6 w-6 group-open:block" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" />
          </svg>
        </summary>
        <ul
          class="absolute right-0 mt-2 min-w-[12rem] rounded-soft border border-border bg-surface p-2 shadow-soft"
        >
          <li>
            <a class="nav-link block w-full" href="/">Home</a>
          </li>
          <li>
            <a class="nav-link block w-full" href="/articles/">Articles</a>
          </li>
          <li>
            <a class="nav-link block w-full" href="/team/">Team</a>
          </li>
        </ul>
      </details>
    </nav>
  </div>
</header>
