---
import Logo from './Logo.astro';

const links = [
  { href: '/#what-is', label: 'My Friends Book' },
  { href: '/#how-it-works', label: 'How It Works' },
  { href: '/#collection', label: 'Collection' },
  { href: '/#story', label: 'Our Story' },
  { href: '/#testimonials', label: 'Testimonials' },
  { href: '/articles/', label: 'Articles' },
];
---

<header class="sticky top-0 z-40 border-b border-border/40 bg-canvas/80 backdrop-blur-md">
  <div class="site-container">
    <nav class="flex min-h-28 items-center justify-between gap-6 py-2" aria-label="Primary">
      <Logo size="sm" withWordmark={true} />

      <ul class="hidden items-center gap-1 md:flex">
        {
          links.map((link) => (
            <li>
              <a class="nav-link" href={link.href}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="flex items-center gap-2">
        <a
          href="/cart/"
          class="relative inline-flex min-h-11 min-w-11 items-center justify-center rounded-soft text-ink-heading no-underline focus-ring"
          aria-label="Cart"
          data-cart-link
        >
          <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="M6.5 7h11l-1 11h-9l-1-11Z"
              stroke="currentColor"
              stroke-width="1.25"
              stroke-linejoin="round"
            />
            <path
              d="M9 7a3 3 0 0 1 6 0"
              stroke="currentColor"
              stroke-width="1.25"
              stroke-linecap="round"
            />
          </svg>
          <span
            class="absolute -right-0.5 -top-0.5 hidden min-w-5 items-center justify-center rounded-full bg-primary px-1.5 py-0.5 text-[11px] font-semibold leading-none text-canvas"
            data-cart-count
            aria-hidden="true"
          ></span>
        </a>

        <details class="group md:hidden" data-mobile-nav>
          <summary
            class="relative z-50 flex min-h-11 min-w-11 cursor-pointer list-none items-center justify-center rounded-soft text-ink-heading focus-ring [&::-webkit-details-marker]:hidden"
            aria-label="Open menu"
            aria-expanded="false"
          >
            <span class="sr-only">Menu</span>
            <svg class="h-6 w-6 group-open:hidden" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" />
            </svg>
            <svg class="hidden h-6 w-6 group-open:block" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" />
            </svg>
          </summary>
          <div
            class="fixed inset-x-0 top-28 bottom-0 z-30 bg-ink-heading/40"
            data-mobile-nav-backdrop
            aria-hidden="true"
          ></div>
          <ul
            class="fixed inset-x-0 top-28 z-40 max-h-[calc(100dvh-7rem)] overflow-y-auto border-b border-border bg-surface px-4 py-3 shadow-soft"
          >
            {
              links.map((link) => (
                <li>
                  <a class="nav-link flex min-h-11 w-full items-center" href={link.href}>
                    {link.label}
                  </a>
                </li>
              ))
            }
            <li>
              <a class="nav-link flex min-h-11 w-full items-center" href="/cart/">Cart</a>
            </li>
          </ul>
        </details>
      </div>
    </nav>
  </div>
</header>

<script>
  import { CART_UPDATED_EVENT, cartCount, getCart } from '../lib/cart';

  function updateCartBadge() {
    const count = cartCount(getCart());
    document.querySelectorAll<HTMLElement>('[data-cart-count]').forEach((badge) => {
      if (count > 0) {
        badge.textContent = String(count);
        badge.classList.remove('hidden');
        badge.classList.add('inline-flex');
      } else {
        badge.textContent = '';
        badge.classList.add('hidden');
        badge.classList.remove('inline-flex');
      }
    });

    document.querySelectorAll<HTMLAnchorElement>('[data-cart-link]').forEach((link) => {
      link.setAttribute('aria-label', count > 0 ? `Cart, ${count} items` : 'Cart');
    });
  }

  function initCartBadge() {
    updateCartBadge();
    if (document.documentElement.dataset.cartBadgeBound === 'true') return;
    window.addEventListener(CART_UPDATED_EVENT, updateCartBadge);
    window.addEventListener('storage', (event) => {
      if (event.key === 'album-amicorum-cart') updateCartBadge();
    });
    document.documentElement.dataset.cartBadgeBound = 'true';
  }

  function initMobileNav() {
    document.querySelectorAll<HTMLDetailsElement>('[data-mobile-nav]').forEach((details) => {
      if (details.dataset.navBound === 'true') return;
      details.dataset.navBound = 'true';

      const summary = details.querySelector('summary');
      const backdrop = details.querySelector('[data-mobile-nav-backdrop]');

      const syncOpenState = () => {
        const open = details.open;
        document.body.classList.toggle('overflow-hidden', open);
        summary?.setAttribute('aria-expanded', open ? 'true' : 'false');
        summary?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      };

      details.addEventListener('toggle', syncOpenState);
      backdrop?.addEventListener('click', () => {
        details.open = false;
      });
      details.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          details.open = false;
        });
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && details.open) details.open = false;
      });
      syncOpenState();
    });
  }

  initCartBadge();
  initMobileNav();
  document.addEventListener('astro:page-load', initCartBadge);
  document.addEventListener('astro:page-load', initMobileNav);
</script>
