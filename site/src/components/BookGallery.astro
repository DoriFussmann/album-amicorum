---
import type { GalleryImage } from '../lib/bookGallery';

interface Props {
  images: GalleryImage[];
  class?: string;
}

const { images, class: className = '' } = Astro.props;
---

<div
  class:list={['relative', className]}
  data-book-gallery
  data-gallery
  tabindex="0"
  aria-label="Edition photos"
>
  <div class="media-warm absolute inset-0 overflow-hidden bg-surface">
    <img
      data-gallery-image
      src={images[0]?.src}
      alt={images[0]?.alt ?? ''}
      width="960"
      height="540"
      class="h-full w-full object-cover transition-opacity duration-300"
      decoding="async"
    />
  </div>

  <button
    type="button"
    class:list={[
      'absolute left-2 top-1/2 z-10 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border border-border bg-canvas/90 text-ink-heading shadow-soft transition hover:bg-surface',
      images.length <= 1 && 'hidden',
    ]}
    data-gallery-prev
    aria-label="Previous image"
  >
    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path
        d="M14.5 6.5L9 12l5.5 5.5"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  </button>
  <button
    type="button"
    class:list={[
      'absolute right-2 top-1/2 z-10 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border border-border bg-canvas/90 text-ink-heading shadow-soft transition hover:bg-surface',
      images.length <= 1 && 'hidden',
    ]}
    data-gallery-next
    aria-label="Next image"
  >
    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path
        d="M9.5 6.5L15 12l-5.5 5.5"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  </button>

  <p
    class="absolute bottom-3 left-1/2 z-10 -translate-x-1/2 rounded-full bg-canvas/90 px-3 py-1 text-sm text-ink-muted shadow-soft"
    data-gallery-status
    aria-live="polite"
  >
    1 / {images.length}
  </p>

  <script type="application/json" class="hidden" data-gallery-images set:html={JSON.stringify(images)} />
</div>

<script>
  import { initBookGalleries } from '../lib/bookGallery';

  initBookGalleries();
  document.addEventListener('astro:page-load', () => initBookGalleries());
</script>
