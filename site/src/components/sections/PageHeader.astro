---
import Breadcrumbs from "seo-core/components/Breadcrumbs.astro";

interface Crumb {
  name: string;
  href: string;
}
interface Section {
  eyebrow?: string;
  h1: string;
  intro: string;
}
interface Props {
  section: Section;
  alt?: boolean;
  primary?: boolean;
  crumbs?: Crumb[];
}
const { section, alt = false, primary = true, crumbs } = Astro.props;
const Tag = primary ? "h1" : "h2";
---
<section class:list={["section", "page-header", alt && "section-alt"]}>
  <div class="container-page flex flex-col gap-5">
    {crumbs && crumbs.length > 0 && <Breadcrumbs crumbs={crumbs} />}
    <div class="section-head">
      {section.eyebrow && <p class="eyebrow reveal">{section.eyebrow}</p>}
      <Tag class="h1 reveal">{section.h1}</Tag>
      <p class="lead reveal">{section.intro}</p>
    </div>
  </div>
</section>
