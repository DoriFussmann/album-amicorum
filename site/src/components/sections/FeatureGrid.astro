---
interface Section {
  id?: string;
  eyebrow?: string;
  heading: string;
  intro?: string;
  items: { title: string; text: string }[];
}
interface Props {
  section: Section;
  alt?: boolean;
}
const { section, alt = false } = Astro.props;
---
<section id={section.id} class:list={["section", alt && "section-alt"]}>
  <div class="container-page stack-lg">
    <div class="section-head">
      {section.eyebrow && <p class="eyebrow reveal">{section.eyebrow}</p>}
      <h2 class="h2 reveal">{section.heading}</h2>
      {section.intro && <p class="lead reveal">{section.intro}</p>}
    </div>
    <ul class="feature-grid" data-count={section.items.length}>
      {section.items.map((item) => (
        <li class="card reveal">
          <h3 class="h3">{item.title}</h3>
          <p class="muted">{item.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
