---
import { getCollection } from "astro:content";
import { ARTICLES_BASE } from "../../config/site";
import ArticleCardGrid from "../ArticleCardGrid.astro";

interface Section {
  heading: string;
  intro?: string;
}
interface Props {
  section: Section;
  alt?: boolean;
}
const { section, alt = false } = Astro.props;
const articles = (await getCollection("articles", ({ data }) => data.draft !== true))
  .sort((a, b) => (b.data.updatedDate || b.data.date).localeCompare(a.data.updatedDate || a.data.date))
  .slice(0, 3);
---
<section class:list={["section", alt && "section-alt"]}>
  <div class="container-page stack-lg">
    <div class="section-head-row">
      <div class="section-head">
        <h2 class="h2 reveal">{section.heading}</h2>
        {section.intro && <p class="lead reveal">{section.intro}</p>}
      </div>
      <a class="btn btn-secondary reveal" href={`/${ARTICLES_BASE}/`}>All articles</a>
    </div>
    <ArticleCardGrid articles={articles} headingLevel={3} summary />
  </div>
</section>
