---
import { getCollection } from "astro:content";
import BookCard from "../shop/BookCard.astro";
import { isListedTheme, sortThemes } from "../../lib/shop/themes";

interface Section {
  id?: string;
  eyebrow?: string;
  heading: string;
  intro?: string;
}
interface Props {
  section: Section;
  alt?: boolean;
}
const { section, alt = false } = Astro.props;
const books = sortThemes((await getCollection("books")).filter(isListedTheme));
---

<section id={section.id} class:list={["section", alt && "section-alt"]}>
  <div class="container-page stack-lg">
    <div class="section-head-row">
      <div class="section-head">
        {section.eyebrow && <p class="eyebrow reveal">{section.eyebrow}</p>}
        <h2 class="h2 reveal">{section.heading}</h2>
        {section.intro && <p class="lead reveal">{section.intro}</p>}
      </div>
      <a class="btn btn-secondary reveal" href="/friend-book/">The Books</a>
    </div>
    <ul class="book-grid" data-count={books.length}>
      {books.map((book) => <BookCard book={book} />)}
    </ul>
  </div>
</section>
<script>
  import { bindAddToCartButtons } from "../../lib/shop/bindAddToCart";
  bindAddToCartButtons();
</script>
