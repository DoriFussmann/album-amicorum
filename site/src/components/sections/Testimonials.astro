---
interface Section {
  id?: string;
  heading: string;
  items: { quote: string; name: string; role: string }[];
}
interface Props {
  section: Section;
  alt?: boolean;
}
const { section, alt = false } = Astro.props;
---
<section id={section.id} class:list={["section", alt && "section-alt"]}>
  <div class="container-page stack-lg">
    <div class="section-head">
      <h2 class="h2 reveal">{section.heading}</h2>
    </div>
    <ul class="quote-grid">
      {section.items.map((item) => (
        <li class="card reveal">
          <figure class="quote-card">
            <blockquote><p>“{item.quote}”</p></blockquote>
            <figcaption>{item.name} · {item.role}</figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>
