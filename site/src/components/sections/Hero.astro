---
import MediaFrame from "../MediaFrame.astro";

interface Slide {
  image: string;
  alt: string;
  src?: string;
}
interface Cta {
  label: string;
  href: string;
}
interface Section {
  eyebrow: string;
  h1: string;
  sub: string;
  cta_primary: Cta;
  cta_secondary?: Cta;
  slides: Slide[];
}
interface Props {
  section: Section;
}
const { section } = Astro.props;

// Two-line headline: line two holds the last two words, with the final word typed in.
const words = section.h1.trim().split(/\s+/);
const lastWord = words.length > 1 ? words[words.length - 1] : "";
const lineTwoLead = words.length > 2 ? words[words.length - 2] : "";
const lineOne = words.slice(0, Math.max(0, words.length - (lineTwoLead ? 2 : 1))).join(" ");
const icon = {
  prev: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>',
  next: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>',
};
---

<section class="hero">
  <div class="texture-grid" aria-hidden="true"></div>
  <div class="texture-dots" aria-hidden="true"></div>
  <div class="container-page hero-grid">
    <div class="hero-copy">
      <p class="eyebrow eyebrow-pill rise">{section.eyebrow}</p>
      <h1 class="h1 hero-title rise">
        {lastWord ? (
          <>
            {lineOne}{lineOne && <br />}
            <span class="line-2">{lineTwoLead && <>{lineTwoLead}{" "}</>}<span class="tw-slot"><span class="tw-ghost" aria-hidden="true">{lastWord}</span><span class="tw-word" data-typewriter>{lastWord}</span></span></span>
          </>
        ) : (
          section.h1
        )}
      </h1>
      <p class="lead rise">{section.sub}</p>
      <div class="hero-actions rise">
        <a class="btn btn-primary" href={section.cta_primary.href}>{section.cta_primary.label}</a>
        {section.cta_secondary && (
          <a class="btn btn-secondary" href={section.cta_secondary.href}>{section.cta_secondary.label}</a>
        )}
      </div>
    </div>
    <div class="carousel rise" aria-roledescription="carousel" aria-label="Featured images" tabindex="0">
      <div class="carousel-viewport">
        {section.slides.map((slide, index) => (
          <div
            class:list={["carousel-slide", index === 0 && "is-active"]}
            role="group"
            aria-roledescription="slide"
            aria-label={`${index + 1} of ${section.slides.length}`}
            aria-hidden={index === 0 ? "false" : "true"}
          >
            <MediaFrame image={slide.image} alt={slide.alt} src={slide.src} eager={index === 0} />
          </div>
        ))}
      </div>
      {section.slides.length > 1 && (
        <div class="carousel-controls">
          <button type="button" class="carousel-prev" aria-label="Previous slide" set:html={icon.prev} />
          <button type="button" class="carousel-next" aria-label="Next slide" set:html={icon.next} />
          <div class="carousel-dots">
            {section.slides.map((_, index) => (
              <button
                type="button"
                class="carousel-dot"
                aria-label={`Show slide ${index + 1}`}
                aria-current={index === 0 ? "true" : "false"}
              />
            ))}
          </div>
          <button type="button" class="carousel-toggle" aria-pressed="true">Pause</button>
        </div>
      )}
    </div>
  </div>
</section>
<script is:inline>
  (function () {
    var roots = document.querySelectorAll(".carousel");
    var reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    var raw = getComputedStyle(document.documentElement).getPropertyValue("--carousel-interval").trim();
    var interval = parseFloat(raw) || 5000;

    roots.forEach(function (root) {
      var slides = Array.prototype.slice.call(root.querySelectorAll(".carousel-slide"));
      var dots = Array.prototype.slice.call(root.querySelectorAll(".carousel-dot"));
      var prev = root.querySelector(".carousel-prev");
      var next = root.querySelector(".carousel-next");
      var toggle = root.querySelector(".carousel-toggle");
      if (slides.length < 2 || !prev || !next || !toggle) return;
      var index = 0;
      var timer = null;
      var userPaused = reduced;
      var hoverPaused = false;

      function render() {
        slides.forEach(function (slide, i) {
          var active = i === index;
          slide.classList.toggle("is-active", active);
          slide.setAttribute("aria-hidden", active ? "false" : "true");
        });
        dots.forEach(function (dot, i) {
          dot.setAttribute("aria-current", i === index ? "true" : "false");
        });
      }
      function go(nextIndex) {
        index = (nextIndex + slides.length) % slides.length;
        render();
      }
      function playing() {
        return !userPaused && !hoverPaused && !reduced;
      }
      function stop() {
        if (timer) clearInterval(timer);
        timer = null;
      }
      function start() {
        stop();
        if (!playing()) return;
        timer = setInterval(function () {
          go(index + 1);
        }, interval);
      }
      function setToggle() {
        var paused = userPaused || reduced;
        toggle.innerHTML = paused
          ? '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l10-6.5z"/></svg>'
          : '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="7" y="5.5" width="3.5" height="13" rx="1"/><rect x="13.5" y="5.5" width="3.5" height="13" rx="1"/></svg>';
        toggle.setAttribute("aria-label", paused ? "Play carousel" : "Pause carousel");
        toggle.setAttribute("aria-pressed", paused ? "false" : "true");
      }

      prev.addEventListener("click", function () {
        go(index - 1);
        start();
      });
      next.addEventListener("click", function () {
        go(index + 1);
        start();
      });
      dots.forEach(function (dot, i) {
        dot.addEventListener("click", function () {
          go(i);
          start();
        });
      });
      toggle.addEventListener("click", function () {
        userPaused = !userPaused;
        setToggle();
        start();
      });
      root.addEventListener("mouseenter", function () {
        hoverPaused = true;
        stop();
      });
      root.addEventListener("mouseleave", function () {
        hoverPaused = false;
        start();
      });
      root.addEventListener("focusin", function () {
        hoverPaused = true;
        stop();
      });
      root.addEventListener("focusout", function (event) {
        if (root.contains(event.relatedTarget)) return;
        hoverPaused = false;
        start();
      });
      root.addEventListener("keydown", function (event) {
        if (event.key === "ArrowLeft") {
          event.preventDefault();
          go(index - 1);
        } else if (event.key === "ArrowRight") {
          event.preventDefault();
          go(index + 1);
        }
      });
      setToggle();
      render();
      start();
    });
  })();
</script>

<script is:inline>
  (function () {
    // Typewriter: type the real final word in once, letter by letter; the text stays in the DOM throughout.
    var el = document.querySelector("[data-typewriter]");
    if (!el || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    var word = el.textContent || "";
    el.textContent = "";
    var letters = word.split("").map(function (ch) {
      var span = document.createElement("span");
      span.textContent = ch;
      span.className = "tw-letter";
      el.appendChild(span);
      return span;
    });
    var i = 0;
    setTimeout(function step() {
      if (i >= letters.length) return;
      letters[i].classList.add("is-typed");
      i += 1;
      setTimeout(step, 95);
    }, 700);
  })();
</script>
