---
import MediaFrame from "../MediaFrame.astro";

interface Section {
  id?: string;
  eyebrow?: string;
  heading: string;
  body: string;
  highlights: { title: string; text: string }[];
  image: string;
  alt: string;
  src?: string;
}
interface Props {
  section: Section;
  alt?: boolean;
  imageSide?: "left" | "right";
}
const { section, alt = false, imageSide = "right" } = Astro.props;
---
<section id={section.id} class:list={["section", alt && "section-alt"]}>
  <div class="container-page split">
    <div class="split-copy">
      {section.eyebrow && <p class="eyebrow reveal">{section.eyebrow}</p>}
      <h2 class="h2 reveal">{section.heading}</h2>
      <p class="lead reveal">{section.body}</p>
      <ul class="highlights">
        {section.highlights.map((item) => (
          <li class="reveal">
            <h3 class="h3">{item.title}</h3>
            <p class="muted">{item.text}</p>
          </li>
        ))}
      </ul>
    </div>
    <div class:list={["reveal", imageSide === "left" && "lg:order-first"]}>
      <MediaFrame image={section.image} alt={section.alt} src={section.src} />
    </div>
  </div>
</section>
