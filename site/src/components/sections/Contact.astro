---
interface Section {
  heading: string;
  body: string;
  email: string;
  response_note?: string;
}
interface Props {
  section: Section;
  alt?: boolean;
}
const { section, alt = false } = Astro.props;
---
<section class:list={["section", alt && "section-alt"]}>
  <div class="container-page">
    <div class="card contact-card measure flex flex-col gap-4 reveal">
      <h2 class="h2">{section.heading}</h2>
      <p class="m-0">{section.body}</p>
      <p class="m-0 contact-email">
        <a href={`mailto:${section.email}`}>{section.email}</a>
      </p>
      {section.response_note && <p class="muted m-0">{section.response_note}</p>}
    </div>
  </div>
</section>
