---
interface Cta {
  label: string;
  href: string;
}
interface Section {
  id?: string;
  heading: string;
  sub?: string;
  cta_primary: Cta;
  cta_secondary?: Cta;
}
interface Props {
  section: Section;
  alt?: boolean;
}
const { section, alt = false } = Astro.props;
---
<section id={section.id} class:list={["section", "section-band", "cta-band", alt && "section-alt"]}>
  <div class="texture-grid" aria-hidden="true"></div>
  <div class="texture-dots" aria-hidden="true"></div>
  <div class="container-page">
    <div class="cta-box reveal">
      <div class="flex flex-col gap-3">
        <h2 class="h2">{section.heading}</h2>
        {section.sub && <p class="lead">{section.sub}</p>}
      </div>
      <div class="hero-actions">
        <a class="btn btn-primary" href={section.cta_primary.href}>{section.cta_primary.label}</a>
        {section.cta_secondary && (
          <a class="btn btn-secondary" href={section.cta_secondary.href}>{section.cta_secondary.label}</a>
        )}
      </div>
    </div>
  </div>
</section>
