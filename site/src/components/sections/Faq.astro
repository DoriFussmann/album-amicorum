---
interface Section {
  id?: string;
  eyebrow?: string;
  heading: string;
  intro?: string;
  cta?: { label: string; href: string };
  items: { q: string; a: string }[];
}
interface Props {
  section: Section;
  alt?: boolean;
}
const { section, alt = false } = Astro.props;
---
<section id={section.id} class:list={["section", alt && "section-alt"]}>
  <div class="container-page">
    <div class="split faq-split">
      <div class="section-head self-start">
        {section.eyebrow && <p class="eyebrow reveal">{section.eyebrow}</p>}
        <h2 class="h2 reveal">{section.heading}</h2>
        {section.intro && <p class="lead reveal">{section.intro}</p>}
        {section.cta && (
          <p class="reveal">
            <a class="btn btn-secondary" href={section.cta.href}>{section.cta.label}</a>
          </p>
        )}
      </div>
      <div class="faq-list reveal">
        {section.items.map((item) => (
          <details class="faq-item" name={`faq-${section.id ?? "page"}`}>
            <summary>{item.q}</summary>
            <p class="muted">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>
