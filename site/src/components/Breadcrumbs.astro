---
interface Crumb {
  label: string;
  href: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="mb-8">
  <ol class="flex flex-wrap items-center gap-2 text-sm text-ink-muted">
    {
      items.map((item, i) => (
        <li class="flex items-center gap-2">
          {i > 0 && (
            <span class="text-border select-none" aria-hidden="true">
              /
            </span>
          )}
          {i < items.length - 1 ? (
            <a
              href={item.href}
              class="text-ink-muted no-underline hover:text-primary hover:underline focus-ring rounded-sm"
            >
              {item.label}
            </a>
          ) : (
            <span class="text-ink" aria-current="page">
              {item.label}
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
