---
interface Props {
  src: string;
  alt: string;
  caption?: string;
  aspectClass?: string;
  class?: string;
  loading?: 'eager' | 'lazy';
  width?: number;
  height?: number;
}

const {
  src,
  alt,
  caption,
  aspectClass = 'aspect-video',
  class: className = '',
  loading = 'lazy',
  width = 1600,
  height = 900,
} = Astro.props;
---

<figure class:list={['media-warm overflow-hidden bg-surface', aspectClass, className]}>
  <img
    src={src}
    alt={alt}
    width={width}
    height={height}
    class="h-full w-full object-cover"
    loading={loading}
    decoding="async"
  />
  {
    caption && (
      <figcaption class="sr-only">{caption}</figcaption>
    )
  }
</figure>
