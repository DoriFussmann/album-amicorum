---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  aspectClass?: string;
  class?: string;
  loading?: 'eager' | 'lazy';
  widths?: number[];
  sizes?: string;
}

const {
  src,
  alt,
  caption,
  aspectClass = 'aspect-video',
  class: className = '',
  loading = 'lazy',
  widths = [480, 800, 1200, 1600],
  sizes = '(min-width: 1024px) 40vw, 100vw',
} = Astro.props;
---

<figure class:list={['media-warm overflow-hidden bg-surface', aspectClass, className]}>
  <Picture
    src={src}
    alt={alt}
    widths={widths}
    sizes={sizes}
    formats={['avif', 'webp']}
    class="h-full w-full object-cover"
    loading={loading}
  />
  {
    caption && (
      <figcaption class="sr-only">{caption}</figcaption>
    )
  }
</figure>
