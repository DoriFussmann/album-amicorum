---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { formatDate } from "seo-core";
import { ARTICLES_BASE } from "../config/site";

interface Props {
  articles: CollectionEntry<"articles">[];
  headingLevel?: 2 | 3;
  /** Show the article's meta description under the title. */
  summary?: boolean;
}
const { articles, headingLevel = 2, summary = false } = Astro.props;
const Heading = headingLevel === 2 ? "h2" : "h3";
---

<ul class="article-grid">
  {articles.map((article) => (
    <li class="card article-card hoverable reveal">
      <a class="article-card-link" href={`/${ARTICLES_BASE}/${article.id}/`}>
        <div class="media-frame">
          <Image
            src={article.data.image}
            alt={article.data.imageAlt}
            width={640}
            height={400}
            widths={[320, 480, 640]}
            sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
            loading="lazy"
          />
        </div>
        {article.data.pillarKeyword && <p class="eyebrow">{article.data.pillarKeyword}</p>}
        <Heading class="card-title">{article.data.h1}</Heading>
      </a>
      {summary && <p class="muted m-0 text-sm">{article.data.description}</p>}
      <p class="card-meta">{formatDate(article.data.updatedDate || article.data.date)}</p>
    </li>
  ))}
</ul>
