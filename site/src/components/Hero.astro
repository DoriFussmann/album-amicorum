---
import Logo from './Logo.astro';
---

<section
  aria-labelledby="hero-heading"
  class="relative isolate flex min-h-[100svh] items-center overflow-hidden"
>
  <img
    src="/images/hero-wash.svg"
    alt=""
    width="1440"
    height="900"
    class="pointer-events-none absolute inset-0 -z-10 h-full w-full object-cover"
    decoding="async"
    fetchpriority="high"
  />
  <div
    class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-b from-canvas/20 via-canvas/55 to-canvas"
    aria-hidden="true"
  >
  </div>

  <div class="site-container hero-enter w-full py-24 md:py-32">
    <div class="mb-8">
      <Logo size="lg" withWordmark={true} stacked={true} link={false} />
    </div>
    <h1 id="hero-heading" class="max-w-3xl text-balance">
      Childhood is too precious to scroll past.
    </h1>
    <p class="mt-6 max-w-xl text-lg text-ink md:text-xl md:leading-[1.5]">
      Beautiful Friend Books inspired by a centuries-old tradition of preserving friendships,
      memories, and childhood by hand.
    </p>
    <div class="mt-10">
      <a class="btn btn-primary" href="#collection">Explore the Collection</a>
    </div>
  </div>
</section>
