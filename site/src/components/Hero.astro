---
// Image brief / prompt: imageBriefs.hero in src/data/imageBriefs.ts
---

<section
  aria-labelledby="hero-heading"
  class="relative isolate min-h-[min(88vh,52rem)] overflow-hidden"
>
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <img
      src="/images/hero.jpg"
      alt=""
      width="1800"
      height="1800"
      class="h-full w-full object-cover object-center"
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
    <div
      class="absolute inset-0 bg-gradient-to-b from-canvas/55 via-canvas/72 to-canvas/92"
    ></div>
    <div class="absolute inset-0 bg-canvas/25"></div>
  </div>

  <div class="site-container hero-enter relative z-10 flex min-h-[min(88vh,52rem)] w-full flex-col justify-center py-20 md:py-28">
    <h1
      id="hero-heading"
      class="max-w-2xl text-balance font-display text-3xl font-bold text-ink-heading md:text-5xl md:leading-tight"
    >
      Friendships, kept by hand.
    </h1>

    <p class="mt-8 max-w-xl text-lg text-ink md:text-xl md:leading-[1.5]">
      Some memories are too meaningful to live on a screen.
    </p>
    <p class="mt-4 max-w-xl text-lg text-ink md:text-xl md:leading-[1.5]">
      My Friends Book invites children to collect the stories, drawings, and handwritten memories of
      the friends who shape their childhood—creating a keepsake that becomes more precious with every
      page.
    </p>
    <div class="mt-10 flex flex-col items-start gap-4 sm:flex-row sm:items-center sm:gap-8">
      <a class="btn btn-primary" href="#collection">Explore the Collection</a>
      <a class="text-sm font-semibold text-primary no-underline hover:underline" href="#what-is">
        Discover My Friends Book
      </a>
    </div>
  </div>
</section>
