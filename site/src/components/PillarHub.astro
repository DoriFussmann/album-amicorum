---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import ArticleCard from './ArticleCard.astro';
import { SITE_NAME } from '../config/site';
import { absoluteUrl } from '../lib/url';
import {
  articleLatestDate,
  articlePillarKeyword,
} from '../lib/articleFilters';
import type { ArticlePillar } from '../lib/pillars';

interface Props {
  pillar: ArticlePillar;
}

const { pillar } = Astro.props;
const canonicalPath = `/articles/${pillar.slug}/`;

const articles = (await getCollection('articles'))
  .filter((article) => !article.data.draft && articlePillarKeyword(article.data) === pillar.name)
  .sort(
    (a, b) => articleLatestDate(b.data).valueOf() - articleLatestDate(a.data).valueOf()
  );

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: absoluteUrl('/') },
    { '@type': 'ListItem', position: 2, name: 'Articles', item: absoluteUrl('/articles/') },
    {
      '@type': 'ListItem',
      position: 3,
      name: pillar.name,
      item: absoluteUrl(canonicalPath),
    },
  ],
};
---

<BaseLayout
  title={`${pillar.name} — ${SITE_NAME}`}
  description={pillar.description}
  canonicalPath={canonicalPath}
  jsonLd={jsonLd}
>
  <section aria-labelledby="pillar-heading" class="section-space">
    <div class="site-container">
      <Breadcrumbs
        items={[
          { label: 'Home', href: '/' },
          { label: 'Articles', href: '/articles/' },
          { label: pillar.name, href: canonicalPath },
        ]}
      />

      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h1 id="pillar-heading">{pillar.name}</h1>
      </div>

      {
        articles.length === 0 ? (
          <p class="text-center text-ink-muted">No articles in this topic yet.</p>
        ) : (
          <ul class="grid list-none gap-8 p-0 sm:grid-cols-2 lg:grid-cols-3">
            {articles.map((article) => (
              <ArticleCard article={article} />
            ))}
          </ul>
        )
      }
    </div>
  </section>
</BaseLayout>
