---
import Logo from './Logo.astro';
import SocialLinks from './SocialLinks.astro';
import { SITE_NAME } from '../config/site';

const links = [
  { href: '/#what-is', label: 'My Friends Book' },
  { href: '/#how-it-works', label: 'How It Works' },
  { href: '/#collection', label: 'Collection' },
  { href: '/#story', label: 'Our Story' },
  { href: '/#testimonials', label: 'Testimonials' },
  // Contact page is future work — interim mailto only
  { href: 'mailto:hello@albumamicorum.com', label: 'Contact' },
];
---

<footer class="mt-auto bg-surface">
  <div class="site-container" aria-hidden="true">
    <img
      src="/images/botanical-border.svg"
      alt=""
      width="1200"
      height="48"
      class="mx-auto w-full max-w-page py-6"
      loading="lazy"
      decoding="async"
    />
  </div>

  <div class="site-container pb-16 pt-2">
    <div class="flex flex-col items-start justify-between gap-10 md:flex-row md:items-start">
      <div class="flex max-w-md flex-col gap-4">
        <Logo size="sm" withWordmark={true} class="opacity-90" />
        <p class="font-display text-lg italic text-ink-muted">Where friendships become keepsakes.</p>
        <p class="text-sm leading-[1.7] text-ink">
          Beautifully illustrated Friend Books that become one-of-a-kind keepsakes of childhood.
        </p>
        <SocialLinks class="mt-1" />
        <p class="mt-2 text-sm text-ink-muted">
          &copy; 2026 {SITE_NAME}
        </p>
        <p class="text-sm text-ink-muted">Made to be treasured.</p>
      </div>
      <nav aria-label="Footer">
        <ul class="flex flex-col gap-2 sm:flex-row sm:flex-wrap sm:gap-x-2 sm:gap-y-1">
          {
            links.map((link) => (
              <li>
                <a class="nav-link" href={link.href}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>
</footer>
