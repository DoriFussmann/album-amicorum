---
import { SITE_NAME } from '../config/site';
import { absoluteUrl } from '../lib/url';
---

<footer class="mt-auto bg-surface">
  <div class="site-container" aria-hidden="true">
    <img
      src="/images/botanical-border.svg"
      alt=""
      width="1200"
      height="48"
      class="mx-auto w-full max-w-page py-6"
      loading="lazy"
      decoding="async"
    />
  </div>

  <div class="site-container pb-12 pt-2">
    <div class="flex flex-col items-start justify-between gap-8 md:flex-row md:items-center">
      <p class="font-display text-xl text-ink-heading">
        &copy; {new Date().getFullYear()} {SITE_NAME}
      </p>
      <nav aria-label="Footer">
        <ul class="flex flex-wrap gap-x-2 gap-y-1">
          <li><a class="nav-link" href="/">Home</a></li>
          <li><a class="nav-link" href="/articles/">Articles</a></li>
          <li><a class="nav-link" href="/team/">Team</a></li>
          <li><a class="nav-link" href={absoluteUrl('/rss.xml')}>RSS</a></li>
        </ul>
      </nav>
    </div>
  </div>
</footer>
