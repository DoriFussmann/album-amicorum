---
import Logo from './Logo.astro';
import { SITE_NAME } from '../config/site';

const links = [
  { href: '/#what-is', label: 'About' },
  { href: '/#collection', label: 'Shop' },
  { href: '/#story', label: 'Story' },
  { href: '/#testimonials', label: 'Stories' },
  { href: 'mailto:hello@albumamicorum.com', label: 'Contact' },
];
---

<footer class="mt-auto bg-surface">
  <div class="site-container" aria-hidden="true">
    <img
      src="/images/botanical-border.svg"
      alt=""
      width="1200"
      height="48"
      class="mx-auto w-full max-w-page py-6"
      loading="lazy"
      decoding="async"
    />
  </div>

  <div class="site-container pb-12 pt-2">
    <div class="flex flex-col items-start justify-between gap-8 md:flex-row md:items-center">
      <div class="flex flex-col gap-3">
        <Logo size="sm" withWordmark={true} class="opacity-90" />
        <p class="text-sm text-ink-muted">
          &copy; {new Date().getFullYear()} {SITE_NAME}
        </p>
      </div>
      <nav aria-label="Footer">
        <ul class="flex flex-wrap gap-x-2 gap-y-1">
          {
            links.map((link) => (
              <li>
                <a class="nav-link" href={link.href}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>
</footer>
