---
import type { ArticleFilterOption } from '../lib/articleFilters';

interface Props {
  options: ArticleFilterOption[];
}

const { options } = Astro.props;
---

<form id="articles-filters" class="articles-filter-bar mb-10" role="search">
  <label class="articles-filter-bar__field" for="articles-search">
    <span>Search by title</span>
    <input
      id="articles-search"
      name="q"
      type="search"
      autocomplete="off"
      placeholder="Search articles…"
    />
  </label>

  <label class="articles-filter-bar__field" for="articles-topic">
    <span>Pillar keyword</span>
    <select id="articles-topic" name="topic">
      <option value="">All pillars</option>
      {options.map((option) => (
        <option value={option.value}>{option.label}</option>
      ))}
    </select>
  </label>
</form>

<style>
  .articles-filter-bar {
    display: flex;
    gap: 1rem;
    width: 100%;
  }

  .articles-filter-bar__field {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-muted, #6b6358);
  }

  .articles-filter-bar__field input,
  .articles-filter-bar__field select {
    width: 100%;
    min-height: 2.75rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--color-border, #ddd8ce);
    border-radius: 8px;
    background: #fff;
    font: inherit;
    font-size: 0.9rem;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
    color: #3b3530;
  }

  @media (max-width: 639px) {
    .articles-filter-bar {
      flex-direction: column;
    }
  }
</style>

<script>
  const form = document.getElementById('articles-filters');
  const searchInput = document.getElementById('articles-search');
  const topicInput = document.getElementById('articles-topic');
  const emptyMessage = document.getElementById('articles-empty');
  const grid = document.getElementById('articles-grid');

  if (
    form instanceof HTMLFormElement &&
    searchInput instanceof HTMLInputElement &&
    topicInput instanceof HTMLSelectElement &&
    emptyMessage instanceof HTMLElement &&
    grid instanceof HTMLElement
  ) {
    const items = [...grid.querySelectorAll<HTMLElement>(':scope > li')];

    const applyFilters = () => {
      const query = searchInput.value.trim().toLowerCase();
      const topic = topicInput.value;
      let visibleCount = 0;

      for (const item of items) {
        const title = item.dataset.title ?? '';
        const pillar = (item.dataset.pillar ?? '').trim().toLowerCase();
        const matchesSearch = !query || title.includes(query);
        const matchesTopic = !topic || pillar === topic.toLowerCase();
        const show = matchesSearch && matchesTopic;
        item.hidden = !show;
        if (show) visibleCount += 1;
      }

      emptyMessage.hidden = visibleCount > 0;
    };

    const syncFromParams = () => {
      const params = new URLSearchParams(window.location.search);
      searchInput.value = params.get('q') ?? '';
      const topic = params.get('topic') ?? '';
      const valid = !topic || [...topicInput.options].some((opt) => opt.value === topic);
      topicInput.value = valid ? topic : '';
      applyFilters();
    };

    const writeParams = () => {
      const params = new URLSearchParams();
      const query = searchInput.value.trim();
      const topic = topicInput.value;
      if (query) params.set('q', query);
      if (topic) params.set('topic', topic);
      const next = params.toString();
      const url = next ? `${window.location.pathname}?${next}` : window.location.pathname;
      window.history.replaceState({}, '', url);
    };

    searchInput.addEventListener('input', () => {
      writeParams();
      applyFilters();
    });

    topicInput.addEventListener('change', () => {
      writeParams();
      applyFilters();
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      writeParams();
      applyFilters();
    });

    syncFromParams();
  }
</script>
