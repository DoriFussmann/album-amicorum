---
import type { ArticleFilterOption } from '../lib/articleFilters';

interface Props {
  options: ArticleFilterOption[];
}

const { options } = Astro.props;
---

<form id="articles-filters" class="mb-10 flex flex-col gap-6" role="search">
  <div class="min-w-0 w-full max-w-xl">
    <label for="articles-search" class="mb-2 block text-sm text-ink-muted">
      Search by title
    </label>
    <input
      id="articles-search"
      name="q"
      type="search"
      autocomplete="off"
      placeholder="Search articles…"
      class="min-h-11 w-full rounded-soft border border-border bg-canvas px-3 text-sm text-ink-heading placeholder:text-ink-muted"
    />
  </div>

  {
    options.length > 0 && (
      <div>
        <p id="articles-filter-label" class="mb-3 text-sm text-ink-muted">
          Filter by pillar
        </p>
        <div
          id="articles-topic-group"
          class="flex flex-wrap items-center gap-x-5 gap-y-3"
          role="group"
          aria-labelledby="articles-filter-label"
        >
          <button
            type="button"
            data-topic=""
            aria-pressed="true"
            class="article-filter-chip"
          >
            All
          </button>
          {options.map((option) => (
            <button
              type="button"
              data-topic={option.value}
              aria-pressed="false"
              class="article-filter-chip"
            >
              {option.label}
            </button>
          ))}
        </div>
        <input id="articles-topic" name="topic" type="hidden" value="" />
      </div>
    )
  }
</form>

<style>
  .article-filter-chip {
    min-height: 2.75rem;
    border: 0;
    border-bottom: 2px solid transparent;
    background: transparent;
    padding: 0.25rem 0.15rem;
    font-family: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: #6b6358;
    cursor: pointer;
    transition:
      color 280ms ease,
      border-color 280ms ease;
  }

  .article-filter-chip:hover {
    color: #3b3530;
  }

  .article-filter-chip:focus-visible {
    outline: 2px solid #4e684e;
    outline-offset: 4px;
    border-radius: 2px;
  }

  .article-filter-chip[aria-pressed='true'] {
    border-bottom-color: #4e684e;
    color: #3b3530;
  }
</style>

<script>
  const form = document.getElementById('articles-filters');
  const searchInput = document.getElementById('articles-search');
  const topicInput = document.getElementById('articles-topic');
  const topicGroup = document.getElementById('articles-topic-group');
  const emptyMessage = document.getElementById('articles-empty');
  const grid = document.getElementById('articles-grid');
  const pagination = document.querySelector('[data-articles-pagination]');

  if (
    form instanceof HTMLFormElement &&
    searchInput instanceof HTMLInputElement &&
    emptyMessage instanceof HTMLElement &&
    grid instanceof HTMLElement
  ) {
    const items = [...grid.querySelectorAll<HTMLElement>(':scope > li')];
    const chips =
      topicGroup instanceof HTMLElement
        ? [...topicGroup.querySelectorAll<HTMLButtonElement>('button[data-topic]')]
        : [];

    const getTopic = () =>
      topicInput instanceof HTMLInputElement ? topicInput.value : '';

    const setTopic = (topic: string) => {
      if (topicInput instanceof HTMLInputElement) {
        topicInput.value = topic;
      }
      for (const chip of chips) {
        chip.setAttribute('aria-pressed', String(chip.dataset.topic === topic));
      }
    };

    const applyFilters = () => {
      const query = searchInput.value.trim().toLowerCase();
      const topic = getTopic();
      let visibleCount = 0;

      for (const item of items) {
        const title = item.dataset.title ?? '';
        const pillar = item.dataset.pillar ?? '';
        const matchesSearch = !query || title.includes(query);
        const matchesTopic = !topic || pillar === topic;
        const show = matchesSearch && matchesTopic;
        item.hidden = !show;
        if (show) visibleCount += 1;
      }

      emptyMessage.hidden = visibleCount > 0;
      if (pagination instanceof HTMLElement) {
        pagination.hidden = Boolean(query || topic);
      }
    };

    const syncFromParams = () => {
      const params = new URLSearchParams(window.location.search);
      searchInput.value = params.get('q') ?? '';
      const topic = params.get('topic') ?? '';
      const valid = !topic || chips.some((chip) => chip.dataset.topic === topic);
      setTopic(valid ? topic : '');
      applyFilters();
    };

    const writeParams = () => {
      const params = new URLSearchParams();
      const query = searchInput.value.trim();
      const topic = getTopic();
      if (query) params.set('q', query);
      if (topic) params.set('topic', topic);
      const next = params.toString();
      const url = next ? `${window.location.pathname}?${next}` : window.location.pathname;
      window.history.replaceState({}, '', url);
    };

    searchInput.addEventListener('input', () => {
      writeParams();
      applyFilters();
    });

    for (const chip of chips) {
      chip.addEventListener('click', () => {
        setTopic(chip.dataset.topic ?? '');
        writeParams();
        applyFilters();
      });
    }

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      writeParams();
      applyFilters();
    });

    syncFromParams();
  }
</script>
