---
import Reveal from './Reveal.astro';
import SiteImage from './SiteImage.astro';
import storyImage from '../assets/images/story.jpg';
// Image brief / prompt: imageBriefs.story in src/data/imageBriefs.ts
---

<section id="story" aria-labelledby="story-heading" class="section-space bg-surface/50">
  <div class="site-container grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
    <Reveal class="order-2 lg:order-1">
      <SiteImage
        src={storyImage}
        alt="Fairies edition of My Friends Book styled with linen, wildflowers, and colored pencils"
        caption="A tradition of friendship books"
        aspectClass="aspect-[4/3]"
      />
    </Reveal>
    <div class="order-1 lg:order-2">
      <Reveal>
        <p class="text-sm font-semibold tracking-wide text-ink-muted">Our Story</p>
        <h2 id="story-heading" class="mt-3">
          Inspired by a tradition that began more than 450 years ago.
        </h2>
      </Reveal>
      <Reveal delay={90}>
        <p class="mt-6 leading-[1.7]">
          More than four centuries ago, students traveling across Renaissance Europe carried small
          books from place to place, inviting friends and teachers to leave handwritten messages,
          poems, drawings, and signatures along the way.
        </p>
      </Reveal>
      <Reveal delay={160}>
        <p class="mt-4 leading-[1.7]">
          These books became known as <em>Album Amicorum</em>—Latin for "Book of Friends."
        </p>
      </Reveal>
      <Reveal delay={200}>
        <p class="mt-4 leading-[1.7]">That timeless tradition inspired our own.</p>
      </Reveal>
      <Reveal delay={240}>
        <p class="mt-4 leading-[1.7]">
          Today, My Friends Book carries the same spirit into childhood, inviting a new generation to
          preserve friendships one handwritten page at a time.
        </p>
      </Reveal>
    </div>
  </div>
</section>
