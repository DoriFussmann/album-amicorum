---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import WhatIs from '../components/WhatIs.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Collection from '../components/Collection.astro';
import WhyParents from '../components/WhyParents.astro';
import Story from '../components/Story.astro';
import Testimonials from '../components/Testimonials.astro';
import ClosingCta from '../components/ClosingCta.astro';
import { SITE_NAME } from '../config/site';
import { isListedTheme, sortThemes } from '../lib/themes';

const books = sortThemes((await getCollection('books')).filter(isListedTheme));
---

<BaseLayout
  title={`${SITE_NAME} — Friend Books for Childhood`}
  description="Beautiful Friend Books inspired by a centuries-old tradition of preserving friendships, memories, and childhood by hand."
  canonicalPath="/"
>
  <Hero />
  <WhatIs />
  <Collection books={books} />
  <HowItWorks />
  <WhyParents />
  <Story />
  <Testimonials />
  <ClosingCta />
</BaseLayout>
