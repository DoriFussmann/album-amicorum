---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import WhatIs from '../components/WhatIs.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Collection from '../components/Collection.astro';
import WhyParents from '../components/WhyParents.astro';
import Story from '../components/Story.astro';
import Testimonials from '../components/Testimonials.astro';
import ClosingCta from '../components/ClosingCta.astro';
import { isListedTheme, sortThemes } from '../lib/themes';
import { getHeroLcpPreload } from '../lib/heroImage';

const books = sortThemes((await getCollection('books')).filter(isListedTheme));
const lcpImage = await getHeroLcpPreload();
---

<BaseLayout
  title="Friend Books & Memory Books for Kids | Album Amicorum"
  description="Beautifully illustrated friend books for kids — a place to keep handwritten memories, drawings, and friendships, inspired by a 450-year-old tradition."
  canonicalPath="/"
  lcpImage={lcpImage}
>
  <Hero />
  <WhatIs />
  <Collection books={books} />
  <HowItWorks />
  <WhyParents />
  <Story />
  <Testimonials />
  <ClosingCta />
</BaseLayout>
