---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import ArticlesFilters from '../../components/ArticlesFilters.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_NAME } from '../../config/site';
import {
  articleLatestDate,
  articlePillarKeyword,
  buildArticleFilterOptions,
} from '../../lib/articleFilters';

const allArticles = (await getCollection('articles'))
  .filter((a) => !a.data.draft)
  .sort(
    (a, b) => articleLatestDate(b.data).valueOf() - articleLatestDate(a.data).valueOf()
  );

const filterOptions = buildArticleFilterOptions(allArticles.map((a) => a.data));

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout
  title={`Articles — ${SITE_NAME}`}
  description={`Browse all published articles from ${SITE_NAME}.`}
  canonicalPath="/articles/"
>
  <section aria-labelledby="articles-heading" class="section-space">
    <div class="site-container">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h1 id="articles-heading">Articles</h1>
        <p class="mt-4 text-ink-muted">Stories, guides, and notes worth keeping.</p>
      </div>

      {
        allArticles.length === 0 ? (
          <p class="text-center text-ink-muted">No articles published yet.</p>
        ) : (
          <>
            <ArticlesFilters options={filterOptions} />

            <p id="articles-empty" class="mb-0 text-center text-sm text-ink-muted" hidden>
              No articles match your filters.
            </p>

            <ul id="articles-grid" class="grid list-none gap-8 p-0 sm:grid-cols-2 lg:grid-cols-3">
              {allArticles.map((article) => {
                const articleUrl = `/articles/${article.data.slug}/`;
                const displayDate = articleLatestDate(article.data);
                return (
                  <li
                    class="article-card"
                    data-title={article.data.title?.toLowerCase() ?? ''}
                    data-pillar={articlePillarKeyword(article.data) ?? ''}
                  >
                    <a class="article-card__link focus-ring" href={articleUrl}>
                      {article.data.pillarKeyword && (
                        <p class="article-card__pillar">{article.data.pillarKeyword}</p>
                      )}
                      <div class="article-card__hero">
                        <Image
                          src={article.data.image}
                          width={600}
                          height={338}
                          alt={article.data.imageAlt}
                          loading="lazy"
                          widths={[320, 480, 600]}
                          sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                        />
                      </div>
                      <div class="article-card__body">
                        <h2 class="article-card__title">{article.data.title}</h2>
                        <p class="article-card__date">{formatDate(displayDate)}</p>
                        <span class="article-card__cta">To Article →</span>
                      </div>
                    </a>
                  </li>
                );
              })}
            </ul>
          </>
        )
      }
    </div>
  </section>
</BaseLayout>
