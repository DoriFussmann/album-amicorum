---
import { getCollection, getEntry, type CollectionEntry } from "astro:content";
import ArticleLayout from "seo-core/layouts/ArticleLayout.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "seo-core/components/Breadcrumbs.astro";
import ArticleListing from "seo-core/components/ArticleListing.astro";
import { ARTICLES_BASE, LOGO_PATH, SAME_AS, SITE_IDENTITY, SITE_NAME, SITE_URL } from "../../config/site";
import { abs, breadcrumbNode, orgNode, websiteNode } from "seo-core";
import ArticleCardGrid from "../../components/ArticleCardGrid.astro";
import { ARTICLE_PILLARS, type ArticlePillar } from "../../lib/articles/pillars";

export async function getStaticPaths() {
  const PAGE_SIZE = 12;
  const published = (await getCollection("articles", ({ data }) => data.draft !== true)).sort(
    (a, b) => (b.data.updatedDate || b.data.date).localeCompare(a.data.updatedDate || a.data.date),
  );
  const pageCount = Math.max(1, Math.ceil(published.length / PAGE_SIZE));
  const pagePaths = [];
  for (let page = 2; page <= pageCount; page++) {
    pagePaths.push({
      params: { slug: String(page) },
      props: { kind: "page" as const, page, articles: published, pages: pageCount },
    });
  }

  const articleEntries = await getCollection("articles", ({ data }) => {
    if (import.meta.env.DEV) return true;
    return data.draft !== true;
  });
  const articlePaths = articleEntries
    .filter((article) => !/^\d+$/.test(article.id))
    .map((article) => ({
      params: { slug: article.id },
      props: { kind: "article" as const, article },
    }));

  // Topic hubs: one page per pillar, unless an article already owns that slug.
  const articleIds = new Set(articleEntries.map((article) => article.id));
  const pillarPaths = ARTICLE_PILLARS.filter((pillar) => !articleIds.has(pillar.slug)).map((pillar) => ({
    params: { slug: pillar.slug },
    props: {
      kind: "pillar" as const,
      pillar,
      articles: published.filter((article) => article.data.pillarKeyword === pillar.name),
    },
  }));

  return [...pagePaths, ...articlePaths, ...pillarPaths];
}

type Props =
  | { kind: "article"; article: CollectionEntry<"articles"> }
  | { kind: "page"; page: number; articles: CollectionEntry<"articles">[]; pages: number }
  | { kind: "pillar"; pillar: ArticlePillar; articles: CollectionEntry<"articles">[] };

const props = Astro.props as Props;

let author: CollectionEntry<"team"> | undefined;
if (props.kind === "article") {
  author = await getEntry("team", props.article.data.author);
  if (!author) {
    throw new Error(`Missing team member "${props.article.data.author}" for article "${props.article.id}"`);
  }
}

const PAGE_SIZE = 12;
const listing =
  props.kind === "page"
    ? {
        page: props.page,
        pages: props.pages,
        slice: props.articles.slice((props.page - 1) * PAGE_SIZE, props.page * PAGE_SIZE),
        pillars: [...new Set(props.articles.map((a) => a.data.pillarKeyword).filter(Boolean))] as string[],
        canonicalPath: `/${ARTICLES_BASE}/${props.page}/`,
        crumbs: [
          { name: "Home", href: abs("/", SITE_URL) },
          { name: "Articles", href: abs(`/${ARTICLES_BASE}/`, SITE_URL) },
          { name: `Page ${props.page}`, href: abs(`/${ARTICLES_BASE}/${props.page}/`, SITE_URL) },
        ],
      }
    : null;

const hub =
  props.kind === "pillar"
    ? {
        path: `/${ARTICLES_BASE}/${props.pillar.slug}/`,
        crumbs: [
          { name: "Home", href: abs("/", SITE_URL) },
          { name: "Articles", href: abs(`/${ARTICLES_BASE}/`, SITE_URL) },
          { name: props.pillar.name, href: abs(`/${ARTICLES_BASE}/${props.pillar.slug}/`, SITE_URL) },
        ],
      }
    : null;
---

{props.kind === "article" && author && (
  <ArticleLayout
    article={props.article}
    author={author}
    Layout={BaseLayout}
    siteUrl={SITE_URL}
    siteName={SITE_NAME}
    articlesBase={ARTICLES_BASE}
    logo={LOGO_PATH}
    sameAs={SAME_AS}
  />
)}

{props.kind === "page" && listing && (
  <BaseLayout
    title={`${SITE_NAME} articles — Page ${listing.page}`}
    description={`Page ${listing.page} of the Album Amicorum journal: articles on friend books, childhood friendship, handwriting, keepsakes, and screen-free gifts.`}
    canonicalPath={listing.canonicalPath}
    jsonLd={{
      "@context": "https://schema.org",
      "@graph": [orgNode(SITE_IDENTITY), websiteNode(SITE_IDENTITY), breadcrumbNode(listing.crumbs, SITE_URL)],
    }}
  >
    <div class="container-page section flex flex-col gap-6">
      <Breadcrumbs crumbs={listing.crumbs} />
      <h1 class="h1">Articles</h1>
      <ArticleListing articles={listing.slice} pillars={listing.pillars} page={listing.page} pages={listing.pages} articlesBase={ARTICLES_BASE} />
    </div>
  </BaseLayout>
)}

{props.kind === "pillar" && hub && (
  <BaseLayout
    title={`${props.pillar.name} — ${SITE_NAME}`}
    description={props.pillar.description}
    canonicalPath={hub.path}
    jsonLd={{
      "@context": "https://schema.org",
      "@graph": [
        orgNode(SITE_IDENTITY),
        websiteNode(SITE_IDENTITY),
        breadcrumbNode(hub.crumbs, SITE_URL),
        {
          "@type": "CollectionPage",
          "@id": `${abs(hub.path, SITE_URL)}#page`,
          name: props.pillar.name,
          description: props.pillar.description,
          url: abs(hub.path, SITE_URL),
          hasPart: props.articles.map((article) => ({
            "@type": "BlogPosting",
            headline: article.data.title,
            url: abs(`/${ARTICLES_BASE}/${article.id}/`, SITE_URL),
          })),
        },
      ],
    }}
  >
    <div class="container-page section flex flex-col gap-8">
      <Breadcrumbs crumbs={hub.crumbs} />
      <div class="flex flex-col gap-3 measure">
        <p class="eyebrow">Topic</p>
        <h1 class="h1">{props.pillar.name}</h1>
        <p class="lead">{props.pillar.description}</p>
      </div>
      <ArticleCardGrid articles={props.articles} />
    </div>
  </BaseLayout>
)}
