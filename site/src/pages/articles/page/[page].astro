---
import { Image } from 'astro:assets';
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { SITE_NAME } from '../../../config/site';

export async function getStaticPaths() {
  const PAGE_SIZE = 9;
  const all = (await getCollection('articles'))
    .filter((a) => !a.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

  const totalPages = Math.ceil(all.length / PAGE_SIZE);
  // Pages 2..N only — page 1 lives at /articles/
  if (totalPages <= 1) return [];

  return Array.from({ length: totalPages - 1 }, (_, i) => {
    const pageNum = i + 2;
    const start = (pageNum - 1) * PAGE_SIZE;
    return {
      params: { page: String(pageNum) },
      props: {
        pageArticles: all.slice(start, start + PAGE_SIZE),
        allArticles: all,
        currentPage: pageNum,
        totalPages,
      },
    };
  });
}

const { pageArticles, allArticles, currentPage, totalPages } = Astro.props;

const articlesWithAuthors = await Promise.all(
  pageArticles.map(async (article) => {
    const authorEntry = await getEntry('team', article.data.author);
    return {
      article,
      authorName: authorEntry?.data.name ?? article.data.author,
    };
  })
);

const topics = [
  ...new Set(
    allArticles
      .map((a) => a.data.pillarKeyword)
      .filter((topic): topic is string => Boolean(topic))
  ),
].sort((a, b) => a.localeCompare(b));
---

<BaseLayout
  title={`Articles — Page ${currentPage} — ${SITE_NAME}`}
  description={`Browse all published articles from ${SITE_NAME}.`}
  canonicalPath={`/articles/page/${currentPage}/`}
>
  <section aria-labelledby="articles-heading" class="section-space">
    <div class="site-container">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h1 id="articles-heading">Articles</h1>
        <p class="mt-4 text-ink-muted">Stories, guides, and notes worth keeping.</p>
      </div>

      <form
        id="articles-filters"
        class="mb-10 flex flex-col gap-4 sm:flex-row sm:items-end"
        role="search"
      >
        <div class="min-w-0 flex-1">
          <label for="articles-search" class="mb-2 block text-sm text-ink-muted">
            Search by title
          </label>
          <input
            id="articles-search"
            name="q"
            type="search"
            autocomplete="off"
            placeholder="Search articles…"
            class="min-h-11 w-full rounded-soft border border-border bg-canvas px-3 text-sm text-ink-heading placeholder:text-ink-muted"
          />
        </div>
        <div class="w-full sm:w-64">
          <label for="articles-topic" class="mb-2 block text-sm text-ink-muted">Topic</label>
          <select
            id="articles-topic"
            name="topic"
            class="min-h-11 w-full rounded-soft border border-border bg-canvas px-3 text-sm text-ink-heading"
          >
            <option value="">All topics</option>
            {
              topics.map((topic) => (
                <option value={topic}>{topic}</option>
              ))
            }
          </select>
        </div>
      </form>

      <p id="articles-empty" class="mb-0 text-center text-sm text-ink-muted" hidden>
        No articles match your filters.
      </p>

      <ul id="articles-grid" class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {
          articlesWithAuthors.map(({ article, authorName }) => (
            <li
              data-title={article.data.title.toLowerCase()}
              data-topic={article.data.pillarKeyword ?? ''}
            >
              <a
                href={`/articles/${article.data.slug}/`}
                class="card-link group flex h-full flex-col overflow-hidden rounded-soft border border-border/70 bg-canvas no-underline hover:no-underline"
              >
                <div class="article-hero-frame">
                  <Image
                    src={article.data.image}
                    alt={article.data.imageAlt}
                    width={600}
                    height={338}
                    loading="lazy"
                  />
                </div>
                <div class="flex flex-1 flex-col p-6">
                  <span class="font-display text-xl font-semibold text-ink-heading transition-colors duration-gentle group-hover:text-primary">
                    {article.data.title}
                  </span>
                  <p class="mt-3 flex-1 text-sm leading-[1.7] text-ink">{article.data.description}</p>
                  <p class="mt-4 text-xs font-light uppercase tracking-wider text-ink-muted">
                    <time datetime={article.data.date.toISOString()}>
                      {article.data.date.toLocaleDateString('en-US', {
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric',
                      })}
                    </time>
                    <span aria-hidden="true"> · </span>
                    <span class="normal-case tracking-normal">{authorName}</span>
                  </p>
                </div>
              </a>
            </li>
          ))
        }
      </ul>

      <nav aria-label="Pagination" class="mt-16" data-articles-pagination>
        <ul class="flex flex-wrap items-center justify-center gap-4">
          <li>
            <a
              class="btn btn-secondary"
              href={currentPage === 2 ? '/articles/' : `/articles/page/${currentPage - 1}/`}
            >
              Previous
            </a>
          </li>
          <li>
            <span
              aria-current="page"
              class="inline-flex min-h-11 items-center px-3 text-sm text-ink-muted"
            >
              Page {currentPage} of {totalPages}
            </span>
          </li>
          {
            currentPage < totalPages && (
              <li>
                <a class="btn btn-secondary" href={`/articles/page/${currentPage + 1}/`}>
                  Next
                </a>
              </li>
            )
          }
        </ul>
      </nav>
    </div>
  </section>

  <script>
    const form = document.getElementById('articles-filters');
    const searchInput = document.getElementById('articles-search');
    const topicSelect = document.getElementById('articles-topic');
    const emptyMessage = document.getElementById('articles-empty');
    const grid = document.getElementById('articles-grid');
    const pagination = document.querySelector('[data-articles-pagination]');

    if (
      form instanceof HTMLFormElement &&
      searchInput instanceof HTMLInputElement &&
      topicSelect instanceof HTMLSelectElement &&
      emptyMessage instanceof HTMLElement &&
      grid instanceof HTMLElement
    ) {
      const items = [...grid.querySelectorAll<HTMLElement>(':scope > li')];

      const applyFilters = () => {
        const query = searchInput.value.trim().toLowerCase();
        const topic = topicSelect.value;
        let visibleCount = 0;

        for (const item of items) {
          const title = item.dataset.title ?? '';
          const itemTopic = item.dataset.topic ?? '';
          const matchesSearch = !query || title.includes(query);
          const matchesTopic = !topic || itemTopic === topic;
          const show = matchesSearch && matchesTopic;
          item.hidden = !show;
          if (show) visibleCount += 1;
        }

        emptyMessage.hidden = visibleCount > 0;
        if (pagination instanceof HTMLElement) {
          pagination.hidden = Boolean(query || topic);
        }
      };

      const syncFromParams = () => {
        const params = new URLSearchParams(window.location.search);
        searchInput.value = params.get('q') ?? '';
        const topic = params.get('topic') ?? '';
        topicSelect.value = [...topicSelect.options].some((o) => o.value === topic) ? topic : '';
        applyFilters();
      };

      const writeParams = () => {
        const params = new URLSearchParams();
        const query = searchInput.value.trim();
        const topic = topicSelect.value;
        if (query) params.set('q', query);
        if (topic) params.set('topic', topic);
        const next = params.toString();
        const url = next ? `${window.location.pathname}?${next}` : window.location.pathname;
        window.history.replaceState({}, '', url);
      };

      searchInput.addEventListener('input', () => {
        writeParams();
        applyFilters();
      });
      topicSelect.addEventListener('change', () => {
        writeParams();
        applyFilters();
      });
      form.addEventListener('submit', (event) => {
        event.preventDefault();
        writeParams();
        applyFilters();
      });

      syncFromParams();
    }
  </script>
</BaseLayout>
