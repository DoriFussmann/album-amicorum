---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import BookGallery from '../../components/BookGallery.astro';
import { bookGalleryAlt } from '../../lib/bookImageAlt';
import { absoluteUrl } from '../../lib/url';
import { SITE_NAME, SITE_URL } from '../../config/site';

const books = (await getCollection('books'))
  .filter((book) => !book.data.hidden)
  .sort((a, b) => a.data.order - b.data.order);

if (books.length === 0) {
  throw new Error('Product page requires at least one non-hidden book edition.');
}

const defaultEdition = books[0];

function galleryFor(book: (typeof books)[number]) {
  const sources = book.data.gallery?.length
    ? book.data.gallery
    : [book.data.cover, book.data.interior];
  return sources.map((src) => ({
    src,
    alt: bookGalleryAlt(book.data.title, src),
  }));
}

function offerPrice(price: string): string {
  const match = price.replace(/,/g, '').match(/[\d.]+/);
  return match ? Number.parseFloat(match[0]).toFixed(2) : '0.00';
}

const editionsBySlug = Object.fromEntries(
  books.map((book) => [
    book.data.slug,
    {
      slug: book.data.slug,
      title: book.data.title,
      price: book.data.price,
      cover: book.data.cover,
      gallery: galleryFor(book),
    },
  ]),
);

const defaultGallery = galleryFor(defaultEdition);
const defaultCartPayload = JSON.stringify({
  slug: defaultEdition.data.slug,
  title: defaultEdition.data.title,
  price: defaultEdition.data.price,
  cover: defaultEdition.data.cover,
});

// Editable product copy (keyword tuning is Dori's call — keep the H1 general).
const PRODUCT_H1 = 'Friend Book for Kids';
const PRODUCT_TITLE = 'Friend Book for Kids — A Fill-In Keepsake of Childhood Friendships';
const PRODUCT_DESCRIPTION =
  'A fill-in Friend Book children pass among friends for handwritten memories, drawings, and messages. Six illustrated cover editions, $30, ships worldwide.';
// One-line OG swap: change this path to use a different lifestyle asset.
const PRODUCT_OG_IMAGE = '/images/og-default.jpg';

const PRODUCT_LEAD_1 =
  'My Friends Book invites friends to leave handwritten memories, drawings, favorite things, and messages that together become a keepsake unlike any other.';
const PRODUCT_LEAD_2 =
  'Every completed book tells a different story because every friendship is different.';

const productGroupDescription = `${PRODUCT_LEAD_1} ${PRODUCT_LEAD_2}`;

const canonicalPath = '/friend-book/';

const productGroupLd = {
  '@context': 'https://schema.org',
  '@type': 'ProductGroup',
  name: 'My Friends Book',
  description: productGroupDescription,
  brand: {
    '@type': 'Organization',
    name: SITE_NAME,
    url: SITE_URL,
  },
  url: absoluteUrl(canonicalPath),
  productGroupID: 'my-friends-book',
  variesBy: ['https://schema.org/pattern'],
  hasVariant: books.map((book) => ({
    '@type': 'Product',
    name: `My Friends Book — ${book.data.title}`,
    sku: book.data.slug,
    image: absoluteUrl(book.data.cover),
    url: absoluteUrl(`${canonicalPath}?edition=${book.data.slug}`),
    offers: {
      '@type': 'Offer',
      price: offerPrice(book.data.price),
      priceCurrency: 'USD',
      availability: 'https://schema.org/InStock',
      itemCondition: 'https://schema.org/NewCondition',
    },
  })),
};
// TODO(F-20): add AggregateRating once real reviews exist

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: absoluteUrl('/') },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Friend Book',
      item: absoluteUrl(canonicalPath),
    },
  ],
};
---

<BaseLayout
  title={PRODUCT_TITLE}
  description={PRODUCT_DESCRIPTION}
  canonicalPath={canonicalPath}
  ogImage={absoluteUrl(PRODUCT_OG_IMAGE)}
  jsonLd={[productGroupLd, breadcrumbLd]}
>
  <section class="section-space" aria-labelledby="product-heading" data-product-page>
    <div class="site-container">
      <Breadcrumbs
        items={[
          { label: 'Home', href: '/' },
          { label: 'Friend Book', href: canonicalPath },
        ]}
      />

      <div class="grid items-start gap-10 lg:grid-cols-2 lg:gap-16">
        <BookGallery
          images={defaultGallery}
          class="aspect-[4/5] min-h-[22rem] overflow-hidden rounded-soft lg:min-h-[32rem]"
        />

        <div data-cart-scope data-product-buy>
          <h1 id="product-heading">{PRODUCT_H1}</h1>
          <p class="mt-4 leading-[1.45]">{PRODUCT_LEAD_1}</p>
          <p class="mt-2 leading-[1.45]">{PRODUCT_LEAD_2}</p>

          <p class="mt-6 text-sm font-semibold tracking-wide text-ink-heading" data-edition-label>
            Edition: {defaultEdition.data.title}
          </p>

          <div
            class="mt-4"
            role="radiogroup"
            aria-labelledby="edition-selector-label"
            data-edition-radiogroup
          >
            <p id="edition-selector-label" class="mb-3 text-sm text-ink-muted">Choose a cover</p>
            <div class="grid grid-cols-3 gap-3 sm:grid-cols-6">
              {
                books.map((book, i) => (
                  <div
                    role="radio"
                    aria-checked={i === 0 ? 'true' : 'false'}
                    tabindex={i === 0 ? 0 : -1}
                    data-edition={book.data.slug}
                    class="flex cursor-pointer flex-col items-center gap-2 rounded-soft border border-border bg-canvas p-2 text-center transition hover:border-primary focus-ring aria-checked:border-primary aria-checked:ring-2 aria-checked:ring-primary"
                  >
                    <img
                      src={book.data.cover}
                      alt=""
                      width="120"
                      height="120"
                      class="aspect-square w-full object-contain"
                      loading="lazy"
                      decoding="async"
                    />
                    <span class="text-xs font-semibold leading-tight text-ink-heading">
                      {book.data.title}
                    </span>
                  </div>
                ))
              }
            </div>
          </div>

          <p class="mt-6 text-sm font-semibold tracking-wide text-ink-heading" data-product-price>
            {defaultEdition.data.price}
          </p>
          <p class="mt-1 text-sm text-ink-muted">Shipping calculated separately at checkout.</p>

          <div class="mt-6">
            <button
              type="button"
              class="btn btn-primary"
              data-add-to-cart
              data-cart-item={defaultCartPayload}
            >
              Add to Cart
            </button>
          </div>
          <p class="mt-2 min-h-5 text-sm text-ink-muted" data-cart-feedback aria-live="polite"></p>
        </div>
      </div>
    </div>

    <script type="application/json" class="hidden" data-editions set:html={JSON.stringify(editionsBySlug)} />
  </section>
</BaseLayout>

<script>
  import { bindAddToCartButtons } from '../../lib/bindAddToCart';
  import { initBookGalleries, setGalleryImages, type GalleryImage } from '../../lib/bookGallery';

  type Edition = {
    slug: string;
    title: string;
    price: string;
    cover: string;
    gallery: GalleryImage[];
  };

  function parseEditions(root: HTMLElement): Record<string, Edition> {
    const script = root.querySelector<HTMLScriptElement>('[data-editions]');
    if (!script?.textContent) return {};
    try {
      const parsed = JSON.parse(script.textContent) as Record<string, Edition>;
      return parsed && typeof parsed === 'object' ? parsed : {};
    } catch {
      return {};
    }
  }

  function selectEdition(
    root: HTMLElement,
    editions: Record<string, Edition>,
    slug: string,
    updateUrl: boolean,
  ) {
    const edition = editions[slug];
    if (!edition) return;

    root.querySelectorAll<HTMLElement>('[role="radio"][data-edition]').forEach((el) => {
      const on = el.getAttribute('data-edition') === slug;
      el.setAttribute('aria-checked', on ? 'true' : 'false');
      el.tabIndex = on ? 0 : -1;
    });

    const label = root.querySelector('[data-edition-label]');
    if (label) label.textContent = `Edition: ${edition.title}`;

    const priceEl = root.querySelector('[data-product-price]');
    if (priceEl) priceEl.textContent = edition.price;

    const gallery = root.querySelector<HTMLElement>('[data-book-gallery]');
    if (gallery) setGalleryImages(gallery, edition.gallery);

    const addButton = root.querySelector<HTMLButtonElement>('[data-add-to-cart]');
    if (addButton) {
      addButton.setAttribute(
        'data-cart-item',
        JSON.stringify({
          slug: edition.slug,
          title: edition.title,
          price: edition.price,
          cover: edition.cover,
        }),
      );
    }

    if (updateUrl) {
      const url = new URL(window.location.href);
      url.searchParams.set('edition', slug);
      history.replaceState(null, '', `${url.pathname}${url.search}`);
    }
  }

  function initProductPage() {
    const root = document.querySelector<HTMLElement>('[data-product-page]');
    if (!root || root.dataset.productBound === 'true') return;

    initBookGalleries(root);
    bindAddToCartButtons();

    const editions = parseEditions(root);
    const slugs = Object.keys(editions);
    if (!slugs.length) return;

    const radios = [...root.querySelectorAll<HTMLElement>('[role="radio"][data-edition]')];
    const requested = new URLSearchParams(window.location.search).get('edition');
    const initial =
      requested && editions[requested] ? requested : (radios[0]?.getAttribute('data-edition') ?? slugs[0]);

    selectEdition(root, editions, initial, false);

    radios.forEach((radio) => {
      radio.addEventListener('click', () => {
        const slug = radio.getAttribute('data-edition');
        if (!slug) return;
        selectEdition(root, editions, slug, true);
        radio.focus();
      });
    });

    const group = root.querySelector<HTMLElement>('[data-edition-radiogroup]');
    group?.addEventListener('keydown', (event) => {
      const keys: Record<string, number> = {
        ArrowRight: 1,
        ArrowDown: 1,
        ArrowLeft: -1,
        ArrowUp: -1,
      };
      const current = radios.findIndex((el) => el.getAttribute('aria-checked') === 'true');
      if (event.key === 'Home' || event.key === 'End') {
        event.preventDefault();
        const next = event.key === 'Home' ? radios[0] : radios[radios.length - 1];
        const slug = next?.getAttribute('data-edition');
        if (slug) {
          selectEdition(root, editions, slug, true);
          next.focus();
        }
        return;
      }
      const delta = keys[event.key];
      if (!delta || current < 0) return;
      event.preventDefault();
      const nextIndex = (current + delta + radios.length) % radios.length;
      const next = radios[nextIndex];
      const slug = next?.getAttribute('data-edition');
      if (slug) {
        selectEdition(root, editions, slug, true);
        next.focus();
      }
    });

    root.dataset.productBound = 'true';
  }

  initProductPage();
  document.addEventListener('astro:page-load', initProductPage);
</script>
