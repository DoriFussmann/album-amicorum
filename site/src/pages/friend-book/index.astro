---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Collection from '../../components/Collection.astro';
import { SITE_NAME } from '../../config/site';
import { absoluteUrl } from '../../lib/url';
import { isListedTheme, productGroupLd, sortThemes } from '../../lib/themes';

const books = sortThemes((await getCollection('books')).filter(isListedTheme));

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: absoluteUrl('/') },
    { '@type': 'ListItem', position: 2, name: 'Friend Book', item: absoluteUrl('/friend-book/') },
  ],
};

const productGroupJsonLd = productGroupLd(books);
// TODO(F-20): add AggregateRating once real reviews exist
---

<BaseLayout
  title={`My Friends Book — ${SITE_NAME}`}
  description="Beautiful Friend Books inspired by a centuries-old tradition of preserving friendships, memories, and childhood by hand."
  canonicalPath="/friend-book/"
  jsonLd={[productGroupJsonLd, breadcrumbLd]}
>
  <div class="site-container pt-16 md:pt-24">
    <Breadcrumbs
      items={[
        { label: 'Home', href: '/' },
        { label: 'Friend Book', href: '/friend-book/' },
      ]}
    />
  </div>
  <Collection books={books} />
</BaseLayout>
