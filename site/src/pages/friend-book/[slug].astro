---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "seo-core/components/Breadcrumbs.astro";
import ProductGallery from "../../components/shop/ProductGallery.astro";
import BookCard from "../../components/shop/BookCard.astro";
import { abs, breadcrumbNode, orgNode, websiteNode } from "seo-core";
import { SITE_IDENTITY, SITE_URL } from "../../config/site";
import { bookImage, bookImageSrc, bookOgImageSrc } from "../../lib/shop/bookAssets";
import { bookGalleryAlt } from "../../lib/shop/bookImageAlt";
import {
  PRODUCT_LEAD_1,
  PRODUCT_LEAD_2,
  SHIPPING_NOTE,
  hasVisibleMarkdown,
  isListedTheme,
  isSoldTheme,
  productLd,
  sortThemes,
  themeMetaDescription,
  themeMetaTitle,
  themePageTitle,
} from "../../lib/shop/themes";

export async function getStaticPaths() {
  const books = sortThemes((await getCollection("books")).filter(isSoldTheme));
  return books.map((book) => ({ params: { slug: book.data.slug }, props: { book } }));
}

interface Props {
  book: CollectionEntry<"books">;
}
const { book } = Astro.props;
const { data } = book;

const others = sortThemes((await getCollection("books")).filter(isListedTheme)).filter(
  (entry) => entry.data.slug !== data.slug,
);
const sources = data.gallery?.length ? data.gallery : [data.cover, data.interior];
const images = sources.map((src) => ({ src: bookImage(src), alt: bookGalleryAlt(data.title, src) }));

const cartItem = JSON.stringify({
  slug: data.slug,
  title: data.title,
  price: data.price,
  cover: await bookImageSrc(data.cover),
});

const canonicalPath = `/friend-book/${data.slug}/`;
const crumbs = [
  { name: "Home", href: abs("/", SITE_URL) },
  { name: "The Books", href: abs("/friend-book/", SITE_URL) },
  { name: data.title, href: abs(canonicalPath, SITE_URL) },
];
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [orgNode(SITE_IDENTITY), websiteNode(SITE_IDENTITY), breadcrumbNode(crumbs, SITE_URL), await productLd(book)],
};

const showStory = hasVisibleMarkdown(book.body);
const { Content } = showStory ? await render(book) : { Content: null };
---

<BaseLayout
  title={themeMetaTitle(data.title, data.metaTitle)}
  description={themeMetaDescription(data.title, data.tagline, data.price, data.metaDescription)}
  canonicalPath={canonicalPath}
  robots={data.draft ? "noindex, follow" : undefined}
  ogType="product"
  ogImage={await bookOgImageSrc(data.cover)}
  jsonLd={jsonLd}
>
  <section class="section">
    <div class="container-page flex flex-col gap-6">
      <Breadcrumbs crumbs={crumbs} />
      <div class="grid items-start gap-10 lg:grid-cols-2 lg:gap-16">
        <ProductGallery images={images} />
        <div class="product-info flex flex-col gap-4" data-cart-scope>
          <p class="eyebrow">My Friends Book</p>
          <h1 class="h1">{themePageTitle(data.title)}</h1>
          <p class="lead">{data.tagline}</p>
          <p>{PRODUCT_LEAD_1}</p>
          <p class="muted">{PRODUCT_LEAD_2}</p>
          <div class="product-buy">
            <p class="price price-lg">{data.price}</p>
            <p class="muted text-sm">{SHIPPING_NOTE}</p>
          </div>
          <div class="flex flex-wrap gap-3">
            <button type="button" class="btn btn-primary" data-add-to-cart data-cart-item={cartItem}>Add to Cart</button>
            <a class="btn btn-secondary" href="/cart/">View Cart</a>
          </div>
          <p class="cart-feedback muted" data-cart-feedback aria-live="polite"></p>
          <ul class="product-facts">
            <li>Made for ages 5–12</li>
            <li>Filled in by hand by friends, family, and teachers</li>
            <li>Flat-rate shipping to more than 40 countries</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  {showStory && Content && (
    <section class="section section-alt">
      <div class="container-page">
        <div class="prose-article measure mx-auto">
          <Content />
        </div>
      </div>
    </section>
  )}

  {others.length > 0 && (
    <section class="section">
      <div class="container-page flex flex-col gap-8">
        <h2 class="h2">Other editions</h2>
        <ul class="book-grid">
          {others.map((entry, index) => <BookCard book={entry} index={index} />)}
        </ul>
      </div>
    </section>
  )}
</BaseLayout>

<script>
  import { bindAddToCartButtons } from "../../lib/shop/bindAddToCart";
  bindAddToCartButtons();
</script>
