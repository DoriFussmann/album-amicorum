---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Thank you | Album Amicorum"
  description="Your Friend Book order is confirmed."
  canonicalPath="/order-confirmation/"
  robots="noindex, follow"
>
  <section class="section-space" aria-labelledby="confirmation-heading">
    <div class="site-container mx-auto max-w-content text-center">
      <h1 id="confirmation-heading">Thank you.</h1>
      <p class="mt-6 leading-[1.7] text-ink">Your Friend Book is on its way.</p>
      <p class="mt-4 leading-[1.7] text-ink">
        Before long, it will begin collecting the handwritten memories, drawings, and friendships that
        make childhood unforgettable.
      </p>
      <p class="mt-4 leading-[1.7] text-ink">We can't wait for its story to begin.</p>
      <p class="mt-8 text-sm text-ink-muted">
        Payments are securely processed through Stripe. A receipt will arrive by email from Stripe.
      </p>
      <div class="mt-10">
        <a class="btn btn-primary" href="/">Return Home</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { clearCart } from '../lib/cart';

  const params = new URLSearchParams(window.location.search);
  if (params.get('session_id')) {
    clearCart();
  }
</script>
