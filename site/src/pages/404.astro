---
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';
import { SITE_NAME } from '../config/site';
---

<BaseLayout
  title={`Page not found — ${SITE_NAME}`}
  description={`The page you requested could not be found on ${SITE_NAME}.`}
  canonicalPath="/404/"
  robots="noindex, follow"
>
  <section aria-labelledby="not-found-heading" class="section-space">
    <div class="site-container text-center">
      <div class="mb-8 flex justify-center">
        <Logo size="md" withWordmark={false} link={false} />
      </div>
      <h1 id="not-found-heading">This page seems to have wandered off.</h1>
      <p class="mt-4 text-ink-muted">Let's help you find your way back.</p>
      <nav aria-label="Recovery" class="mt-10">
        <a class="btn btn-primary" href="/">Return Home</a>
      </nav>
    </div>
  </section>
</BaseLayout>
